+def _drop_private_pages(paths: Iterable[str]) -> None:
+    """Discard the private pages of this process's mappings of `paths`.
+
+    safetensors maps each shard MAP_PRIVATE. On a coherent-memory GPU (GB10,
+    sm_121) a device copy straight out of that mapping faults its pages in
+    for write, so every byte read becomes an anonymous copy that lives as
+    long as the mapping, i.e. the whole run: ~3.7 GB per TR3 layer, never
+    evictable. Nothing here writes a checkpoint, so MADV_DONTNEED loses no
+    data; the next read refaults the file's own bytes.
+    """
+    import ctypes
+
+    wanted = {os.path.realpath(path) for path in paths}
+    try:
+        maps = open("/proc/self/maps", "r", encoding="utf-8")
+    except OSError:  # pragma: no cover - non-Linux hosts
+        return
+    with maps:
+        ranges = [line.split(None, 5) for line in maps]
+    libc = ctypes.CDLL(None, use_errno=True)
+    libc.madvise.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int]
+    for fields in ranges:
+        if len(fields) == 6 and fields[1].endswith("p") and fields[5].rstrip("\n") in wanted:
+            start, stop = (int(value, 16) for value in fields[0].split("-"))
+            if libc.madvise(start, stop - start, 4) != 0:  # MADV_DONTNEED
+                errno = ctypes.get_errno()
+                raise OSError(errno, "madvise(MADV_DONTNEED) on %s: %s"
+                              % (fields[5].rstrip("\n"), os.strerror(errno)))
+
+
