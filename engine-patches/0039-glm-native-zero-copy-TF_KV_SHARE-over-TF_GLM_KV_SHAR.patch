+/// TF_KV_SHARE + TF_GLM_KV_SHARD: the two sharded parts' pools on rank 0 (null: unsharded or window mode).
+pub fn share_sharded(ptr: *anyopaque) ?kp.ShardedPools {
+    const e: *engine.Engine = @ptrCast(@alignCast(ptr));
+    const p = e.pages orelse return null;
+    const x = p.shard orelse return null;
+    return .{ .pools = .{ &x.parts.pools[0], &x.parts.pools[1] }, .h = x.parts.h, .page_bytes = p.layout.pageBytes() };
+}
