+test "kv shard pages: adopted TF_KV_SHARE pages stay in their part without twins, skip poison, and concurrent twins never starve 4 streams" {
+    const gpa = std.testing.allocator;
+    var f: Fake = undefined;
+    Fake.reset();
+    try f.init(gpa, 0, true);
+    // 4 streams, h = 10 pages per part (24 total -> half(24) = 10), ratio h/n = 3.33 (mirrors 4x519K on 3824/part):
+    // without non-starving twin reserve, streams 0..2 would each borrow a 3-page twin leaving (1, 1) and starving stream 3.
+    const p = try f.pool(4, 24, true);
+    defer f.deinit(p);
+    const x = p.shard.?;
+    try expectEqual(@as(usize, 10), x.parts.h);
+    // Admit 4 concurrent 3-page streams (1100 prompt + 100 reply = 3 pages each): must all admit without waiting!
+    _ = try p.open(0, 1100, 100);
+    _ = try p.open(1, 1100, 100);
+    _ = try p.open(2, 1100, 100);
+    try expect(p.fits(1100, 100)); // 4th stream MUST fit immediately (twin borrowing did not starve it!)
+    _ = try p.open(3, 1100, 100);
+    // Simulate TF_KV_SHARE retaining slot 1's first 2 pages in part 1 before closing all 4 streams
+    const s1_part = x.parts.slots[1].part;
+    try expectEqual(@as(u8, 1), s1_part);
+    const keep_ids = [2]u32{ x.parts.slots[1].ids.items[0], x.parts.slots[1].ids.items[1] };
+    for (keep_ids) |id| x.parts.pools[1].retain(id - @as(u32, @intCast(x.parts.h))); // store holds them
+    for (0..4) |s| p.close(@intCast(s));
+    try expectEqual(@as(usize, 2), x.parts.pools[1].reclaimable());
+    // Resume slot 1 with adopted pages: retain once more for begin(), openWith, poison skips kept pages, twin == 0
+    for (keep_ids) |id| x.parts.pools[1].retain(id - @as(u32, @intCast(x.parts.h)));
+    p.poison = true;
+    F.fills = 0;
+    const wire = try p.openWith(1, 1100, 100, &keep_ids);
+    try expectEqual(@as(usize, 3), wire.len); // 3 pages, 0 twin
+    try expectEqual(@as(usize, 0), p.twinCount(1));
+    try expectEqualSlices(u32, &keep_ids, wire[0..2]);
+    try expectEqual(@as(usize, 1), F.fills); // rank 0 does not own part 1 latents: only 1 fresh key page poisoned, 2 kept skipped!
+    p.close(1);
+    for (keep_ids) |id| x.parts.release(id); // store drops them
+    try expectEqual(@as(usize, 10), x.parts.pools[0].available());
+    try expectEqual(@as(usize, 10), x.parts.pools[1].available());
+}
