+    /// Rank 0: slot `slot` takes `n` pages of part `part`, adopting `adopted` (global ids already in `part` and held
+    /// by the prompt cache for this call; `held.*` flips false once the lease owns them). Never borrows a twin, since
+    /// the peer rank does not hold the adopted prefix's latent rows.
+    pub fn openAdopted(p: *Parts, slot: usize, part: u8, n: usize, adopted: []const u32, held: *bool) !void {
+        const s = &p.slots[slot];
+        if (s.used or part > 1 or adopted.len > n) return error.SlotTaken;
+        const off: u32 = @intCast(@as(usize, part) * p.h);
+        for (adopted) |id| if (partOf(id, p.h) != part) return error.KvShardPlacement;
+        const pool = &p.pools[part];
+        try pool.promise(&s.lease, n - adopted.len);
+        errdefer pool.finish(&s.lease);
+        const local = try p.gpa.alloc(u32, adopted.len);
+        defer p.gpa.free(local);
+        for (adopted, local) |id, *out| out.* = id - off;
+        held.* = false; // pool.adopt releases `local` on OOM and takes ownership on success
+        try pool.adopt(&s.lease, local);
+        try pool.cover(&s.lease, n, null);
+        s.ids.clearRetainingCapacity();
+        try s.ids.ensureTotalCapacity(p.gpa, n);
+        for (s.lease.ids.items) |id| s.ids.appendAssumeCapacity(@intCast(id + @as(usize, part) * p.h));
+        s.part = part;
+        s.used = true;
+        s.twin.clearRetainingCapacity();
+    }
+
+    /// Rank 0: release one non-lease hold on global page `id` (prompt cache adoption rollback).
+    pub fn release(p: *Parts, id: u32) void {
+        const part = partOf(id, p.h);
+        std.debug.assert(part < 2);
+        p.pools[part].release(@intCast(id - part * p.h));
+    }
+
     /// Rank 0: a twin of `n` pages in the other part for slot `slot`, all or none; false when that part lacks them.
+    /// Uses only immediately free pages (`available()`) so a temporary twin never evicts prompt-cache pages.
     pub fn borrow(p: *Parts, slot: usize, n: usize) bool {
         const s = &p.slots[slot];
         if (n == 0 or n > s.ids.items.len or s.twin.items.len > 0) return false;
         const other: u8 = 1 - s.part;
         const pool = &p.pools[other];
-        if (!pool.fits(n)) return false;
+        if (pool.available() < n) return false;
         pool.promise(&s.twin_lease, n) catch return false;
         pool.cover(&s.twin_lease, n, null) catch {
             pool.finish(&s.twin_lease);
