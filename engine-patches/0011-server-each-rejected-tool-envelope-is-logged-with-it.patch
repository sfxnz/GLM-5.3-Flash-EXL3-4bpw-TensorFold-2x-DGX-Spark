+    const tools = (try json.parse(a, "[{\"type\":\"function\",\"function\":{\"name\":\"tool_call\",\"parameters\":{\"type\":\"object\",\"properties\":{\"calls\":{\"type\":\"array\"}}}}}]")).ok.array;
