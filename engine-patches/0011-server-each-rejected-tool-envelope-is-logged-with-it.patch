+    const r = try tp.parse(a, "<tool_call>tool_call<arg_key>calls</arg_key><arg_value>[{\"arguments\":{}}]</arg_value></tool_call>", tools, null);
+    try std.testing.expectEqualStrings("tool_call", r.calls.?[0].get("function").?.get("name").?.string);
