+        if (k2 == 8) return .{ .f = (if (e.pdl) e.grouped_p else e.grouped_s)[@intFromBool(rows > 8 or items)], .nt = 4, .pdl = e.pdl };
+        return .{ .f = e.grouped[@backingInt(l.codebook)], .nt = 8 };
+    }
 };
 
