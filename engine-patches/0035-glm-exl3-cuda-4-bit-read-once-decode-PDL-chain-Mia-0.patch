+    /// 4-bit read-once grouped kernel choice for decode windows up to 32 rows (MiaAI-Lab 0081+0082, Apache-2.0).
+    fn tilesFor(e: *const Experts, l: Layer, rows: usize, items: bool, which: enum { gate_up, down }) struct { f: Function, nt: usize, pdl: bool = false } {
+        const n = if (which == .gate_up) l.width else l.dims;
+        if (!e.shfl or l.codebook != .mcg or rows > 32 or n % 64 != 0) return .{ .f = e.grouped[@backingInt(l.codebook)], .nt = 8 };
