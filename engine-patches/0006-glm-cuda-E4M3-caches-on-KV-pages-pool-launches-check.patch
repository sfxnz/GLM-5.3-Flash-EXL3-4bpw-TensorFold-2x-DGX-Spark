diff --git a/zig/glm_snapshot_host.zig b/zig/glm_snapshot_host.zig
index 37330a3cc..573d64b71 100644
--- a/zig/glm_snapshot_host.zig
+++ b/zig/glm_snapshot_host.zig
@@ -678,3 +678,63 @@ test "GLM snapshots: an E4M3 paged sequence keeps and resumes its codes, scales
         f.e.cur = window;
     }
 }
+
+test "GLM snapshots: an E4M3 state kept on one paged stream restores into another stream on other pages, its table its own" {
+    var d = rec.init();
+    var f: Fixture = undefined;
+    try f.initFormat(&d, 1, 2, false, true); // a follower's share, beside DFlash2: no head
+    defer f.deinit();
+    const c = f.e.c;
+    var w: glm.weights.Weights = undefined;
+    w.config = c;
+    w.share = f.e.share;
+    var layers: [2]glm.weights.Layer = undefined;
+    layers[0].mixer = .{ .mla = undefined };
+    layers[1].mixer = .{ .kda = undefined };
+    w.layers = &layers;
+    const page = glm.state.pageBytesOf(&w, true, false);
+    // one pool of 20 pages, the two streams' tables disjoint and shuffled
+    const ids_a = [_]u32{ 13, 2, 19, 7, 0, 11, 5, 16, 9, 3 };
+    const ids_b = [_]u32{ 4, 17, 8, 1, 14, 10, 18, 6, 12, 15 };
+    var kv = try cuda.DeviceBuffer.alloc(&d, 20 * page);
+    defer kv.free();
+    const at: glm.state.Paged = .{ .kv = kv.ptr, .pages = glm.pages.tableLen(16448), .page_bytes = page };
+    var a = f.seq;
+    a.st = try glm.forward.State.initPagedFormat(t.allocator, &d, &w, 16448, at, true, false);
+    defer a.st.deinit();
+    var b = f.seq;
+    b.st = try glm.forward.State.initPagedFormat(t.allocator, &d, &w, 16448, at, true, false);
+    defer b.st.deinit();
+    for ([_]*@TypeOf(a){ &a, &b }, [_][]const u32{ &ids_a, &ids_b }) |q, ids| {
+        q.st.pages = ids;
+        q.st.capacity = ids.len * 512;
+        @memset(rec.bytes(q.st.table, ids.len * 4), 0x77); // each table is its stream's: a restore leaves it alone
+    }
+    try f.e.prepareSnapshots(2 * f.e.stateBytes(4096));
+    for ([_]usize{ 1537, 4096 }) |at_row| {
+        // stream a's rows on its pages, as its prompt wrote them
+        @memset(rec.bytes(kv.ptr, kv.len), 0);
+        const arena = rec.bytes(a.st.arena.buf.ptr, a.st.arena.buf.len);
+        for (arena, 0..) |*x, i| x.* = @truncate(i *% 29 +% at_row);
+        @memset(rec.bytes(a.st.table, ids_a.len * 4), 0x77); // the pattern ran over a's own table (its arena's end)
+        for (ids_a) |id| for (rec.bytes(kv.ptr + id * page, page), 0..) |*x, i| {
+            x.* = @truncate(i *% 13 +% id);
+        };
+        try a.st.restoreHost(f.e.stream, at_row, 0, &.{1}, .{ 0, 0 });
+        f.e.cur = &a;
+        const id = try f.e.keepState();
+        // b's pages hold other bytes; the restore writes b's own pages through b's ids
+        for (ids_b) |pid| @memset(rec.bytes(kv.ptr + pid * page, page), 0xE9);
+        const a_pages = try t.allocator.dupe(u8, rec.bytes(kv.ptr, kv.len));
+        defer t.allocator.free(a_pages);
+        f.e.cur = &b;
+        try f.e.restoreState(id);
+        try expectSamePrefix8(c, &a.st, &b.st, at_row, null);
+        try t.expectEqual(at_row, b.st.pos);
+        for (ids_a) |pid| try t.expectEqualSlices(u8, a_pages[pid * page ..][0..page], rec.bytes(kv.ptr + pid * page, page)); // a's untouched
+        for ([_]*@TypeOf(a){ &a, &b }, [_][]const u32{ &ids_a, &ids_b }) |q, ids| for (rec.bytes(q.st.table, ids.len * 4)) |x| try t.expectEqual(@as(u8, 0x77), x);
+        f.e.dropState(id);
+        f.e.dropped.clearRetainingCapacity();
+    }
+    f.e.cur = &f.seq;
+}
diff --git a/zig/src/core/contract/glm_kv_paged_records.zig b/zig/src/core/contract/glm_kv_paged_records.zig
new file mode 100644
index 000000000..f86953ac5
--- /dev/null
+++ b/zig/src/core/contract/glm_kv_paged_records.zig
@@ -0,0 +1,52 @@
+//! GLM's E4M3 latent cache on KV pages: nvcc 13.0's receipts owed, 13.3's in measurements/pending_133.zig.
+//! Each paged launch is its window twin's (glm_kv_pending.zig) with a page table: same image, block and shared bytes.
+const std = @import("std");
+const registry = @import("registry.zig");
+const limits = @import("limits.zig");
+
+pub const cuda = [_]registry.CudaRecord{
+    .{ .launch = .{ .name = "glm_glue tf_glm_lat_write_fp8_paged", .symbol = "tf_glm_lat_write_fp8_paged", .image = "glm_glue", .threads = 512, .min_sm = 80 }, .usage = registry.none },
+    .{ .launch = .{ .name = "glm_glue tf_glm_chunks_16_fp8_paged", .symbol = "tf_glm_chunks_16_fp8_paged", .image = "glm_glue", .threads = 256, .dynamic = 83328, .opt_in = true, .min_sm = 80 }, .usage = registry.none },
+    .{ .launch = .{ .name = "glm_glue tf_glm_chunks_32_fp8_paged", .symbol = "tf_glm_chunks_32_fp8_paged", .image = "glm_glue", .threads = 256, .dynamic = 101120, .opt_in = true, .min_sm = 80 }, .usage = registry.none },
+};
+
+fn twin(paged: registry.CudaRecord) !registry.CudaRecord {
+    const symbol = paged.launch.symbol[0 .. paged.launch.symbol.len - "_paged".len];
+    for (@import("glm_kv_pending.zig").records) |r| if (std.mem.eql(u8, r.launch.symbol, symbol)) return r;
+    return error.MissingRecord;
+}
+
+test "GLM FP8 KV pages: 13.0 pending, 13.3's receipts fit every SM, and each launch is its window twin's" {
+    for (cuda) |r| {
+        try std.testing.expect(std.mem.endsWith(u8, r.launch.symbol, "_paged"));
+        try std.testing.expect(std.mem.endsWith(u8, r.launch.name, r.launch.symbol));
+        try std.testing.expectEqual(registry.none, registry.usageFor(r, .{ .major = 13, .minor = 0 }));
+        const got = registry.usageFor(r, .{ .major = 13, .minor = 3 });
+        for (limits.sms, got) |sm, u| {
+            try std.testing.expect(u.regs > 0 and u.bound == r.launch.threads);
+            var text: std.ArrayList(u8) = .empty;
+            defer text.deinit(std.testing.allocator);
+            try std.testing.expectEqual(@as(usize, 0), try limits.cuda(r.launch, u, sm, &text, std.testing.allocator));
+        }
+        // the table changes addressing only: the block, its shared bytes and the image are the window kernel's
+        const w = try twin(r);
+        try std.testing.expectEqualStrings(w.launch.image, r.launch.image);
+        try std.testing.expectEqual(w.launch.threads, r.launch.threads);
+        try std.testing.expectEqual(w.launch.dynamic, r.launch.dynamic);
+        try std.testing.expectEqual(w.launch.opt_in, r.launch.opt_in);
+        try std.testing.expectEqual(w.launch.min_sm, r.launch.min_sm);
+        for (registry.usageFor(w, .{ .major = 13, .minor = 3 }), got) |a, b| {
+            try std.testing.expectEqual(a.static, b.static);
+            try std.testing.expectEqual(a.bound, b.bound);
+        }
+    }
+}
+
+test "GLM FP8 KV pages: every paged launch is registered once, beside the window's three" {
+    var n: usize = 0;
+    for (registry.all_cuda) |r| {
+        if (std.mem.startsWith(u8, r.launch.symbol, "tf_glm_") and std.mem.endsWith(u8, r.launch.symbol, "_fp8_paged")) n += 1;
+    }
+    try std.testing.expectEqual(cuda.len, n);
+    for (cuda) |r| _ = try twin(r);
+}
