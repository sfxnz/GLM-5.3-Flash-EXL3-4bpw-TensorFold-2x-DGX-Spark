+test "glm graphs: TF_GLM_GRAPHS reads 0, 1 and check, nothing else" {
+    try std.testing.expectEqual(Mode.off, parse("0").?);
+    try std.testing.expectEqual(Mode.on, parse("1").?);
+    try std.testing.expectEqual(Mode.check, parse("check").?);
+    for ([_][]const u8{ "2", "on", "true", "CHECK", "01", "" }) |v| try std.testing.expect(parse(v) == null);
+}
+
+test "glm graphs: sharded role, latent page table, and shared segment changes produce distinct keys" {
+    var l: dsa_block.Layer = undefined;
+    l.dense_limit = 2048;
+    const base_c: dsa_block.Caches = .{ .lc = 0x1000, .ls = 0x1800, .ik = 0x2000, .ig = 0x3000, .pk = 0x4000, .pk_rows = 131074, .pt = 0x5000, .ps = 1024 * 512, .lpt = 0x6000, .lps = 512 * 516 };
+    var caches0 = [_]dsa_block.Caches{base_c};
+    var caches1 = [_]dsa_block.Caches{base_c};
+    caches1[0].lpt = 0x7000;
+    var cur0 = [_]u1{0};
+    var cur1 = [_]u1{0};
+    // Lone key changes on sharded role or latent page table
+    const k_take = verifyKeySharded(&caches0, &cur0, l, 9, 4000, 8, 0x100, .take);
+    const k_give = verifyKeySharded(&caches0, &cur0, l, 9, 4000, 8, 0x100, .give);
+    const k_lpt = verifyKeySharded(&caches1, &cur0, l, 9, 4000, 8, 0x100, .take);
+    try std.testing.expect(!std.meta.eql(k_take, k_give));
+    try std.testing.expect(!std.meta.eql(k_take, k_lpt));
+    // Shared key changes on KDA parity flip, sharded ownership change, or shape change
+    var st0: fw.State = undefined;
+    st0.caches = &caches0;
+    st0.cur = &cur0;
+    st0.pos = 4000;
+    st0.hold = .{ .owner = 0, .twin = false };
+    var st1: fw.State = undefined;
+    st1.caches = &caches1;
+    st1.cur = &cur1;
+    st1.pos = 4000;
+    st1.hold = .{ .owner = 1, .twin = false };
+    const segs = [_]fw.Seg{ .{ .st = &st0, .row0 = 0, .rows = 8 }, .{ .st = &st1, .row0 = 8, .rows = 8 } };
+    const sk0 = sharedVerifyKey(&segs, l, 9, 0, true, 0xabc);
+    const sk_same = sharedVerifyKey(&segs, l, 9, 0, true, 0xabc);
+    try std.testing.expect(std.meta.eql(sk0, sk_same));
+    cur0[0] = 1;
+    try std.testing.expect(!std.meta.eql(sk0, sharedVerifyKey(&segs, l, 9, 0, true, 0xabc)));
+    cur0[0] = 0;
+    st0.hold = .{ .owner = 0, .twin = true };
+    try std.testing.expect(!std.meta.eql(sk0, sharedVerifyKey(&segs, l, 9, 0, true, 0xabc)));
+    st0.hold = .{ .owner = 0, .twin = false };
+    st1.pos = 9000;
+    try std.testing.expect(!std.meta.eql(sk0, sharedVerifyKey(&segs, l, 9, 0, true, 0xabc)));
+}
