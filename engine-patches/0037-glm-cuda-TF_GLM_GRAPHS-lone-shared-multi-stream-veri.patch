+    /// Host-side prep for a graphed lone or shared verify window: validates, calls ready/shared.begin (may rebase), uploads ids.
+    pub fn runReady(f: *const Forward, ids: []const i32) !void {
+        const R = ids.len;
+        for (f.ranks) |r| {
+            if (R == 0 or R > r.b.rows) return error.BadWindow;
+            if (r.segs.len == 0) {
+                try r.st.ready(f.stream, R);
+                r.st.pending = R;
+                r.st.prompt = r.b.prefill;
+            } else try shared.begin(r, R, f.stream);
+            try cuda.copy_source.enqueue(f.d, r.b.ids, std.mem.sliceAsBytes(ids), f.stream);
+        }
+    }
+
+    /// Pure device launches of a non-prefill, no-image-crossing verify window (lone or shared) for CUDA graph capture.
+    pub fn launches(f: *const Forward, R: usize) !void {
