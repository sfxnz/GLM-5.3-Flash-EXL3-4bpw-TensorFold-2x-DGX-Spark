diff --git a/zig/src/families/glm/cuda_graphs.zig b/zig/src/families/glm/cuda_graphs.zig
new file mode 100644
index 000000000..49fdae57d
--- /dev/null
+++ b/zig/src/families/glm/cuda_graphs.zig
@@ -0,0 +1,646 @@
+//! TF_GLM_GRAPHS: lone verify windows, shared multi-stream verify windows, MTP draft steps, and DFlash2 drafter
+//! passes as CUDA graphs, keyed by every host choice (including TF_GLM_KV_SHARD ownership roles & latent page tables).
+//!
+//! - TF_GLM_GRAPHS=1|check: enables CUDA graphs (`check` replays graph then runs eager and compares logits, hidden,
+//!   and taps bit-for-bit across every row).
+//! - TF_GLM_GRAPH_TAPS=1: graphs DFlash2 tap writes (df_tap) for lone (1-8 rows) and shared (1-32 rows) verify windows.
+//! - TF_GLM_SHARED_GRAPHS=0|1 (default 1 when TF_GLM_GRAPHS is on): graphs multi-stream shared verify windows (1-32
+//!   rows, up to 16 segments) including sharded KV NCCL send/recv exchanges.
+//! - TF_GLM_DRAFT_GRAPHS=1: graphs DFlash2 block passes (1-8 streams) and context ingests (1-64 rows).
+//! - TF_GLM_GRAPH_MAX / TF_GLM_SHARED_GRAPH_MAX: per-rank graph cache caps; TF_GLM_GRAPH_FLOOR_GIB (default 4 GiB)
+//!   halts new captures under the free-RAM floor while replaying held graphs.
+const std = @import("std");
+const cuda = @import("cuda");
+const gc = cuda.graph_cache;
+const sparse = @import("cuda_sparse.zig");
+const latent = @import("cuda_latent.zig");
+const dsa_block = @import("cuda_dsa_block.zig");
+const fw = @import("cuda_forward.zig");
+const weights = @import("cuda_weights.zig");
+const taps_mod = @import("cuda_taps.zig");
+const kv_attn = @import("cuda_kv_shard_attn.zig");
+
+pub const Mode = enum(u8) { off = 0, on = 1, check = 2 };
+
+/// TF_GLM_GRAPHS' value: 0, 1 or check (null: anything else).
+pub fn parse(v: []const u8) ?Mode {
+    if (std.mem.eql(u8, v, "0")) return .off;
+    if (std.mem.eql(u8, v, "1")) return .on;
+    if (std.mem.eql(u8, v, "check")) return .check;
+    return null;
+}
+
+/// Lone verify windows graphed: 1-4 rows (or 1-8 under TF_GLM_GRAPH_TAPS on a DFlash2 boot).
+pub const verify_rows = 4;
+pub const tap_rows = 8;
+/// Shared verify windows graphed: up to 32 rows, up to 16 segments (Engine.shared_rows / Engine.max_shared).
+pub const shared_verify_rows: usize = 32;
+pub const shared_verify_segs: usize = 16;
+pub const default_shared_cap: u32 = 32;
+/// TF_GLM_DRAFT_GRAPHS: drafter block passes for 1-8 streams (covers C1/C4/C8), ingests for 1-64 rows.
+pub const block_streams: usize = 8;
+pub const ingest_rows: usize = 64;
+
+/// A drafter graph's key: a block pass of `n` streams (rank0: with selector projection), or an ingest of `n` rows.
+pub const BlockKey = struct { ingest: bool, n: u16, rank0: bool };
+
+/// Bytes of one row's DFlash2 taps (dflash.TAP_ROW).
+const tap_row = taps_mod.layers.len * taps_mod.hidden * 2;
+
+/// What a DSA layer's launches take from the host for `rows` rows at `pos` (dsa_block.attend, sparse.selectTokens).
+pub const Shape = struct {
+    dense: bool, // pos < dense_limit: dense attention
+    sparse: bool, // dsa_block.sparseRows: selection and sparse attention (both at a window across the edge)
+    nch: u32, // the dense attention's 512-key chunks (its grid's z), capped by the buffers
+    np: u32, // sparse.poolBucket: the pools selection scores (quick, wide, dscore and dsel follow it)
+    nb: u32, // the score kernel's 64-column blocks (sparse.scoreColumns)
+    dsel: u32, // sparse.dselScanCtas: the decode select's scan grid
+};
+
+pub fn shapeAt(l: dsa_block.Layer, pk_rows: usize, nch_cap: usize, pos: usize, rows: usize) Shape {
+    const sp = dsa_block.sparseRows(l, pos, rows);
+    const np = sparse.poolBucket(pos, rows, pk_rows - 2);
+    return .{
+        .dense = pos < l.dense_limit,
+        .sparse = sp,
+        .nch = @intCast(@min(latent.chunksFor(pos + rows), nch_cap)),
+        .np = if (sp) @intCast(np) else 0,
+        .nb = if (sp) @intCast(std.math.divCeil(usize, sparse.scoreColumns(pos, rows, np), 64) catch unreachable) else 0,
+        .dsel = if (sp) @intCast(sparse.dselScanCtas(pos, rows, np)) else 0,
+    };
+}
+
+fn cacheWords(c: dsa_block.Caches) [11]u64 {
+    return .{ c.lc, c.ls, c.ik, c.ig, c.pk, c.pk_rows, c.pt, c.ps, c.pks, c.lpt, c.lps };
+}
+
+fn mix64(h: u64, v: u64) u64 {
+    var x = h ^ v;
+    x *%= 0x100000001b3;
+    return x ^ (x >> 33);
+}
+
+fn mix128(lo: *u64, hi: *u64, v: u64) void {
+    lo.* = mix64(lo.*, v);
+    hi.* = mix64(hi.*, v ^ 0x9e3779b97f4a7c15 ^ (lo.* >> 17));
+}
+
+/// A one-row MTP draft step's key: equal keys launch equal graphs.
+pub const DraftKey = struct {
+    caches: u64,
+    first: bool,
+    shape: Shape,
+};
+
+pub fn draftKey(c: dsa_block.Caches, l: dsa_block.Layer, nch_cap: usize, mtp_len: usize) DraftKey {
+    const w = cacheWords(c);
+    return .{ .caches = gc.fingerprintOf(&w), .first = mtp_len == 0, .shape = shapeAt(l, c.pk_rows, nch_cap, mtp_len, 1) };
+}
+
+/// A lone verify window's key (includes TF_GLM_KV_SHARD ownership role and latent page table).
+pub const VerifyKey = struct {
+    rows: u8,
+    role: u8 = 0,
+    state: u64,
+    shape: Shape,
+    taps: u64 = 0,
+};
+
+pub fn verifyKey(caches: []const dsa_block.Caches, cur: []const u1, l: ?dsa_block.Layer, nch_cap: usize, pos: usize, rows: usize) VerifyKey {
+    return verifyKeySharded(caches, cur, l, nch_cap, pos, rows, 0, .local);
+}
+
+pub fn verifyKeySharded(caches: []const dsa_block.Caches, cur: []const u1, l: ?dsa_block.Layer, nch_cap: usize, pos: usize, rows: usize, state_ptr: usize, role: kv_attn.Role) VerifyKey {
+    var h: u64 = mix64(0xcbf29ce484222325, @intCast(state_ptr));
+    for (caches) |c| {
+        const w = cacheWords(c);
+        h = mix64(h, gc.fingerprintOf(&w));
+    }
+    for (cur) |x| h = mix64(h, @as(u64, x));
+    const none = std.mem.zeroes(Shape);
+    return .{
+        .rows = @intCast(rows),
+        .role = @intFromEnum(role),
+        .state = h,
+        .shape = if (l) |a| (if (caches.len > 0) shapeAt(a, caches[0].pk_rows, nch_cap, pos, rows) else none) else none,
+    };
+}
+
+/// A shared multi-stream verify window's key: 128-bit state + 128-bit per-segment shape hash, segment count,
+/// total rows, and tap destination address. Covers all KDA/DSA segment pointers, parities, sharded roles, and grids.
+pub const SharedVerifyKey = struct {
+    rows: u8,
+    segs: u8,
+    state_lo: u64,
+    state_hi: u64,
+    shapes_lo: u64,
+    shapes_hi: u64,
+    taps: u64 = 0,
+};
+
+pub fn sharedVerifyKey(segs: []const fw.Seg, l: ?dsa_block.Layer, nch_cap: usize, rank: usize, sharded: bool, taps: u64) SharedVerifyKey {
+    var st_lo: u64 = 0xcbf29ce484222325;
+    var st_hi: u64 = 0x84222325cbf29ce4;
+    var sh_lo: u64 = 0x517cc1b727220a95;
+    var sh_hi: u64 = 0x27220a95517cc1b7;
+    var total_rows: usize = 0;
+    for (segs) |g| {
+        total_rows += g.rows;
+        const role: kv_attn.Role = if (sharded) kv_attn.role(g.st.hold, rank) else .local;
+        mix128(&st_lo, &st_hi, @intFromPtr(g.st));
+        mix128(&st_lo, &st_hi, (@as(u64, @intCast(g.row0)) << 16) | (@as(u64, @intCast(g.rows)) << 4) | @intFromEnum(role));
+        for (g.st.caches) |c| {
+            const w = cacheWords(c);
+            mix128(&st_lo, &st_hi, gc.fingerprintOf(&w));
+        }
+        var cur_bits: u64 = 0;
+        for (g.st.cur, 0..) |x, idx| {
+            cur_bits |= (@as(u64, x) << @intCast(idx & 63));
+            if ((idx & 63) == 63 or idx + 1 == g.st.cur.len) {
+                mix128(&st_lo, &st_hi, cur_bits);
+                cur_bits = 0;
+            }
+        }
+        if (l) |a| {
+            if (g.st.caches.len > 0) {
+                const s = shapeAt(a, g.st.caches[0].pk_rows, nch_cap, g.st.pos, g.rows);
+                const flags: u64 = (@as(u64, @intFromBool(s.dense)) << 1) | @intFromBool(s.sparse);
+                mix128(&sh_lo, &sh_hi, (flags << 32) | s.nch);
+                mix128(&sh_lo, &sh_hi, (@as(u64, s.np) << 32) | s.nb);
+                mix128(&sh_lo, &sh_hi, (@as(u64, s.dsel) << 16) | @as(u64, @intCast(g.rows)));
+            }
+        }
+    }
+    return .{
+        .rows = @intCast(total_rows),
+        .segs = @intCast(segs.len),
+        .state_lo = st_lo,
+        .state_hi = st_hi,
+        .shapes_lo = sh_lo,
+        .shapes_hi = sh_hi,
+        .taps = taps,
+    };
+}
+
+/// Why a draft step runs eagerly under TF_GLM_GRAPHS (null: it is graphed).
+pub fn draftEagerBecause(f: *const fw.Forward, ids_len: usize) !?[]const u8 {
+    if (f.ranks.len != 1) return "local ranks";
+    if (ids_len != 1) return "rows";
+    const lo = f.ranks[0].st.mtp_len + 1;
+    if (f.images) |im| if (try im.v.crosses(im.slot, lo, lo + ids_len)) return "image rows";
+    if (f.prof != null) return "profiler";
+    if (f.taps != null) return "drafter taps";
+    if (f.ranks[0].st.mtp_caches.pks != 0) return "host KV";
+    if (f.ranks[0].b.prefill) return "prompt buffers";
+    return null;
+}
+
+pub fn verifyEagerBecause(f: *const fw.Forward, ids_len: usize) !?[]const u8 {
+    return verifyEagerAt(f, ids_len, verify_rows, false);
+}
+
+pub fn verifyEagerAt(f: *const fw.Forward, ids_len: usize, rows: usize, taps: bool) !?[]const u8 {
+    if (f.ranks.len != 1) return "local ranks";
+    if (ids_len == 0 or ids_len > rows) return "rows";
+    const r = f.ranks[0];
+    if (r.b.prefill) return "prompt buffers";
+    if (r.segs.len > 0) return "shared window";
+    if (f.images) |im| if (try im.v.crosses(im.slot, r.st.pos, r.st.pos + ids_len)) return "image rows";
+    if (f.prof != null) return "profiler";
+    if (f.taps != null and !taps) return "drafter taps";
+    for (r.st.caches) |c| if (c.pks != 0) return "host KV";
+    return null;
+}
+
+/// Why a shared verify window runs eagerly under TF_GLM_GRAPHS (null: it is graphed).
+pub fn sharedEagerAt(f: *const fw.Forward, ids_len: usize, taps: bool) ?[]const u8 {
+    if (f.ranks.len != 1) return "local ranks";
+    if (ids_len == 0 or ids_len > shared_verify_rows) return "rows";
+    const r = f.ranks[0];
+    if (r.b.prefill) return "prompt buffers";
+    if (r.segs.len == 0 or r.segs.len > shared_verify_segs) return "segments";
+    if (f.images != null) return "image rows";
+    if (f.prof != null) return "profiler";
+    if (f.taps != null and !taps) return "drafter taps";
+    for (r.segs) |g| for (g.st.caches) |c| if (c.pks != 0) return "host KV";
+    return null;
+}
+
+fn firstMla(layers: []const weights.Layer) ?dsa_block.Layer {
+    for (layers) |l| switch (l.mixer) {
+        .mla => |a| return a,
+        .kda => {},
+    };
+    return null;
+}
+
+/// MemAvailable in GiB (null where /proc/meminfo cannot be read).
+fn memAvailableGiB() ?f64 {
+    var buf: [4096]u8 = undefined;
+    const fd = std.c.open("/proc/meminfo", .{ .ACCMODE = .RDONLY });
+    if (fd < 0) return null;
+    defer _ = std.c.close(fd);
+    const n = std.c.read(fd, &buf, buf.len);
+    if (n <= 0) return null;
+    var it = std.mem.splitScalar(u8, buf[0..@intCast(n)], '\n');
+    while (it.next()) |line| {
+        if (!std.mem.startsWith(u8, line, "MemAvailable:")) continue;
+        var t = std.mem.tokenizeScalar(u8, line["MemAvailable:".len..], ' ');
+        const kb = std.fmt.parseInt(u64, t.next() orelse return null, 10) catch return null;
+        return @as(f64, @floatFromInt(kb)) / (1 << 20);
+    }
+    return null;
+}
+
+pub const default_floor_gib = 4.0;
+var floor_gib: f64 = default_floor_gib;
+
+pub fn floorFrom(v: ?[]const u8) error{BadGraphFloor}!f64 {
+    const s = v orelse return default_floor_gib;
+    const x = std.fmt.parseFloat(f64, std.mem.trim(u8, s, " ")) catch return error.BadGraphFloor;
+    if (!std.math.isFinite(x) or x < 0) return error.BadGraphFloor;
+    return x;
+}
+
+fn room() bool {
+    const a = memAvailableGiB() orelse return true;
+    return a >= floor_gib;
+}
+
+pub fn cacheSettings(max: u32) gc.Settings {
+    return .{ .max = max, .hold = true };
+}
+
+pub const per_slot = perSlot(verify_rows);
+pub fn perSlot(rows: usize) usize {
+    return 4 * rows;
+}
+pub const max_slots = 4;
+
+pub fn verifyCap(slots: usize) u32 {
+    return verifyCapAt(slots, verify_rows);
+}
+
+pub fn verifyCapAt(slots: usize, rows: usize) u32 {
+    const n: usize = @min(@max(slots, 1), max_slots);
+    return @intCast(perSlot(rows) * n);
+}
+
+pub fn maxVerify() !?u32 {
+    const n = try @import("sys").environment.read(?u64, "TF_GLM_GRAPH_MAX", null);
+    return if (n) |v| (if (v == 0) null else @intCast(v)) else null;
+}
+
+pub fn maxSharedVerify() !u32 {
+    const n = try @import("sys").environment.read(?u64, "TF_GLM_SHARED_GRAPH_MAX", null);
+    return if (n) |v| (if (v == 0) 256 else @intCast(v)) else default_shared_cap;
+}
+
+pub fn cappedVerify(slots: usize, rows: usize, max_verify: ?u32) u32 {
+    const cap = verifyCapAt(slots, rows);
+    return if (max_verify) |m| @min(cap, m) else cap;
+}
+
+pub const Graphs = struct {
+    gpa: std.mem.Allocator,
+    mode: Mode,
+    rank: usize,
+    engine: gc.CudaEngine,
+    draft: gc.Cache(DraftKey),
+    verify: gc.Cache(VerifyKey),
+    shared_verify: ?gc.Cache(SharedVerifyKey) = null,
+    draft_print: u64,
+    verify_print: u64,
+    shared_verify_print: u64 = 0,
+    check: ?Check = null,
+    slots: [max_slots]usize = @splat(0),
+    nslots: usize = 0,
+    max_verify: ?u32 = null,
+    mib: f64 = 0,
+    steps: u64 = 0,
+    stats: struct { draft_eager: u64 = 0, verify_eager: u64 = 0, shared_eager: u64 = 0, checked: u64 = 0, differed: u64 = 0 } = .{},
+    draft_why: ?[]const u8 = null,
+    verify_why: ?[]const u8 = null,
+    shared_why: ?[]const u8 = null,
+    rows: usize = verify_rows,
+    taps: bool = false,
+    block: ?gc.Cache(BlockKey) = null,
+    block_eager: u64 = 0,
+
+    const Check = struct {
+        dev: cuda.DeviceBuffer,
+        host: cuda.HostBuffer,
+        keep: usize,
+        half: usize,
+        vocab: usize,
+    };
+
+    const Buffers = @import("cuda_state.zig").Buffers;
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, mode: Mode, rank: usize, bm: *const Buffers, bd: *const Buffers, bs: ?*const Buffers, hidden: usize, vocab: usize, drafter: bool) !*Graphs {
+        std.debug.assert(mode != .off);
+        floor_gib = floorFrom(if (std.c.getenv("TF_GLM_GRAPH_FLOOR_GIB")) |v| std.mem.span(v) else null) catch |e| {
+            std.log.err("TF_GLM_GRAPH_FLOOR_GIB: a GiB count, 0 or more", .{});
+            return e;
+        };
+        const g = try gpa.create(Graphs);
+        errdefer gpa.destroy(g);
+        g.* = .{
+            .gpa = gpa,
+            .mode = mode,
+            .rank = rank,
+            .engine = .{ .d = d },
+            .draft = undefined,
+            .verify = undefined,
+            .draft_print = gc.fingerprintOf(&.{ bm.ids, bm.hin, bm.mx, bm.fnormed, bm.logits, bm.gathered }),
+            .verify_print = gc.fingerprintOf(&.{ bd.ids, bd.x, bd.normed, bd.hidden, bd.fnormed, bd.logits, bd.gathered }),
+        };
+        g.taps = drafter and try @import("sys").environment.read(bool, "TF_GLM_GRAPH_TAPS", false);
+        if (g.taps) g.rows = tap_rows;
+        g.max_verify = try maxVerify();
+        g.draft = gc.Cache(DraftKey).init(gpa, g.engine.engine(), cacheSettings(16));
+        g.draft.name = "glm draft";
+        g.draft.meter = memAvailableGiB;
+        g.draft.room = room;
+        errdefer g.draft.deinit();
+        g.verify = gc.Cache(VerifyKey).init(gpa, g.engine.engine(), cacheSettings(cappedVerify(1, g.rows, g.max_verify)));
+        g.verify.name = "glm verify";
+        g.verify.meter = memAvailableGiB;
+        g.verify.room = room;
+        errdefer g.verify.deinit();
+        if (bs) |sb| if (try @import("sys").environment.read(bool, "TF_GLM_SHARED_GRAPHS", true)) {
+            const scap = try maxSharedVerify();
+            g.shared_verify_print = gc.fingerprintOf(&.{ sb.ids, sb.x, sb.normed, sb.hidden, sb.fnormed, sb.logits, sb.gathered });
+            g.shared_verify = gc.Cache(SharedVerifyKey).init(gpa, g.engine.engine(), cacheSettings(scap));
+            g.shared_verify.?.name = "glm shared verify";
+            g.shared_verify.?.meter = memAvailableGiB;
+            g.shared_verify.?.room = room;
+            if (rank == 0) std.log.info("glm: TF_GLM_SHARED_GRAPHS=1: multi-stream shared verify windows of 1-{d} rows graphed (cap {d} graphs/rank)", .{ shared_verify_rows, scap });
+        };
+        errdefer if (g.shared_verify) |*sv| sv.deinit();
+        if (g.max_verify) |m| if (rank == 0) std.log.info("glm: TF_GLM_GRAPH_MAX={d}: verify graph cache capped at {d} graphs a rank", .{ m, m });
+        if (mode == .check) {
+            const keep = hidden * 2;
+            const check_rows = @max(g.rows, if (g.shared_verify != null) shared_verify_rows else g.rows);
+            const half = check_rows * ((vocab + hidden) * 2 + if (g.taps) tap_row else 0);
+            const dev = try cuda.DeviceBuffer.alloc(d, keep + 2 * half);
+            errdefer {
+                var x = dev;
+                x.free();
+            }
+            g.check = .{ .dev = dev, .host = try cuda.HostBuffer.alloc(d, 2 * half), .keep = keep, .half = half, .vocab = vocab };
+        }
+        if (drafter and try @import("sys").environment.read(bool, "TF_GLM_DRAFT_GRAPHS", false)) {
+            g.block = gc.Cache(BlockKey).init(gpa, g.engine.engine(), cacheSettings(2 * block_streams + ingest_rows));
+            g.block.?.name = "glm drafter";
+            g.block.?.meter = memAvailableGiB;
+            g.block.?.room = room;
+            if (rank == 0) std.log.info("glm: TF_GLM_DRAFT_GRAPHS=1: DFlash2's block passes of 1-{d} streams and ingests of 1-{d} rows as CUDA graphs", .{ block_streams, ingest_rows });
+        }
+        if (g.taps and rank == 0) std.log.info("glm: TF_GLM_GRAPH_TAPS=1: DFlash2's lone (1-{d} rows) and shared (1-{d} rows) verify taps are graphed", .{ g.rows, shared_verify_rows });
+        return g;
+    }
+
+    pub fn deinit(g: *Graphs) void {
+        if (g.steps > 0) g.report();
+        g.draft.deinit();
+        g.verify.deinit();
+        if (g.shared_verify) |*sv| sv.deinit();
+        if (g.block) |*b| b.deinit();
+        if (g.check) |*c| {
+            c.dev.free();
+            c.host.free();
+        }
+        g.gpa.destroy(g);
+    }
+
+    const DraftBody = struct {
+        f: *const fw.Forward,
+        h: u64,
+        fn run(ctx: *anyopaque, _: cuda.Stream) anyerror!void {
+            const s: *const DraftBody = @ptrCast(@alignCast(ctx));
+            try s.f.mtpGraphed(s.h);
+        }
+    };
+
+    const VerifyBody = struct {
+        f: *const fw.Forward,
+        rows: usize,
+        fn run(ctx: *anyopaque, _: cuda.Stream) anyerror!void {
+            const s: *const VerifyBody = @ptrCast(@alignCast(ctx));
+            try s.f.launches(s.rows);
+        }
+    };
+
+    pub fn drafterPass(g: *Graphs, e: anytype, key: BlockKey, print: u64, body: gc.Body, outs: []const [2]u64) !bool {
+        const b = if (g.block) |*b| b else return false;
+        if (key.n == 0 or key.n > (if (key.ingest) ingest_rows else block_streams)) {
+            g.block_eager += 1;
+            return false;
+        }
+        const c = g.check orelse {
+            g.note(try b.run(key, e.stream, print, body), b.stats.capture_mib);
+            return true;
+        };
+        var n: usize = 0;
+        for (outs) |o| n += o[1];
+        if (n > c.half) return error.DrafterCheckTooWide;
+        g.note(try b.run(key, e.stream, print, body), b.stats.capture_mib);
+        try g.snap(e, 0, outs);
+        try body.run(body.ctx, e.stream);
+        try g.snap(e, 1, outs);
+        try g.compare(e, if (key.ingest) "drafter ingest" else "drafter pass", key.n, key, 0, 0, n);
+        return true;
+    }
+
+    pub fn step(g: *Graphs, f: *const fw.Forward, ids: []const i32, hidden: u64) !void {
+        if (try draftEagerBecause(f, ids.len)) |why| {
+            g.eager(&g.stats.draft_eager, &g.draft_why, "draft steps", why);
+            return f.mtp(ids, &.{hidden});
+        }
+        const r = f.ranks[0];
+        try f.mtpReady(r, ids);
+        const key = draftKey(r.st.mtp_caches, r.w.mtp.?.layer.mixer.mla, r.b.nch, r.st.mtp_len);
+        var s: DraftBody = .{ .f = f, .h = hidden };
+        const body: gc.Body = .{ .ctx = &s, .run = DraftBody.run };
+        const c = g.check orelse return g.note(try g.draft.run(key, f.stream, g.draft_print, body), g.draft.stats.capture_mib);
+        const D = c.keep;
+        const outs = [_][2]u64{ .{ r.b.logits, c.vocab * 2 }, .{ r.b.fnormed, D } };
+        try copy(f, c.dev.ptr, hidden, D);
+        g.note(try g.draft.run(key, f.stream, g.draft_print, body), g.draft.stats.capture_mib);
+        try g.snap(f, 0, &outs);
+        try copy(f, hidden, c.dev.ptr, D);
+        try f.mtpGraphed(hidden);
+        try g.snap(f, 1, &outs);
+        try g.compare(f, "draft step", r.st.mtp_len, key, outs[0][1], outs[0][1] + outs[1][1], outs[0][1] + outs[1][1]);
+    }
+
+    pub fn window(g: *Graphs, f: *const fw.Forward, ids: []const i32) !void {
+        if (try verifyEagerAt(f, ids.len, g.rows, g.taps)) |why| {
+            g.eager(&g.stats.verify_eager, &g.verify_why, "verify windows", why);
+            return f.run(ids);
+        }
+        const r = f.ranks[0];
+        const R = ids.len;
+        try f.runReady(ids);
+        g.admit(@intFromPtr(r.st));
+        const role: kv_attn.Role = if (f.kv) |kv| kv_attn.role(r.st.hold, kv.rank) else .local;
+        var key = verifyKeySharded(r.st.caches, r.st.cur, firstMla(r.w.layers), r.b.nch, r.st.pos, R, @intFromPtr(r.st), role);
+        if (f.taps) |t| key.taps = t.out;
+        var s: VerifyBody = .{ .f = f, .rows = R };
+        const body: gc.Body = .{ .ctx = &s, .run = VerifyBody.run };
+        const c = g.check orelse return g.note(try g.verify.run(key, f.stream, g.verify_print, body), g.verify.stats.capture_mib);
+        const D = c.keep;
+        const tapped: [2]u64 = if (f.taps) |t| .{ t.out, R * tap_row } else .{ 0, 0 };
+        const all = [_][2]u64{ .{ r.b.logits, R * c.vocab * 2 }, .{ r.b.fnormed, R * D }, tapped };
+        const outs = all[0 .. if (f.taps != null) 3 else 2];
+        g.note(try g.verify.run(key, f.stream, g.verify_print, body), g.verify.stats.capture_mib);
+        try g.snap(f, 0, outs);
+        try f.launches(R);
+        try g.snap(f, 1, outs);
+        try g.compare(f, "verify window", r.st.pos, key, all[0][1], all[0][1] + all[1][1], all[0][1] + all[1][1] + tapped[1]);
+    }
+
+    /// Forward.run(ids) of a multi-stream shared verify window (Engine.verifyShared) through its CUDA graph cache.
+    pub fn sharedWindow(g: *Graphs, f: *const fw.Forward, ids: []const i32) !void {
+        const sv = if (g.shared_verify) |*x| x else {
+            g.eager(&g.stats.shared_eager, &g.shared_why, "shared verify windows", "TF_GLM_SHARED_GRAPHS=0");
+            return f.run(ids);
+        };
+        if (sharedEagerAt(f, ids.len, g.taps)) |why| {
+            g.eager(&g.stats.shared_eager, &g.shared_why, "shared verify windows", why);
+            return f.run(ids);
+        }
+        const r = f.ranks[0];
+        const R = ids.len;
+        try f.runReady(ids);
+        const taps_ptr: u64 = if (f.taps) |t| t.out else 0;
+        const key = sharedVerifyKey(r.segs, firstMla(r.w.layers), r.b.nch, if (f.kv) |kv| kv.rank else g.rank, f.kv != null, taps_ptr);
+        var s: VerifyBody = .{ .f = f, .rows = R };
+        const body: gc.Body = .{ .ctx = &s, .run = VerifyBody.run };
+        const c = g.check orelse return g.note(try sv.run(key, f.stream, g.shared_verify_print, body), sv.stats.capture_mib);
+        const D = c.keep;
+        const tapped: [2]u64 = if (f.taps) |t| .{ t.out, R * tap_row } else .{ 0, 0 };
+        const all = [_][2]u64{ .{ r.b.logits, R * c.vocab * 2 }, .{ r.b.fnormed, R * D }, tapped };
+        const outs = all[0 .. if (f.taps != null) 3 else 2];
+        g.note(try sv.run(key, f.stream, g.shared_verify_print, body), sv.stats.capture_mib);
+        try g.snap(f, 0, outs);
+        try f.launches(R);
+        try g.snap(f, 1, outs);
+        try g.compare(f, "shared verify window", R, key, all[0][1], all[0][1] + all[1][1], all[0][1] + all[1][1] + tapped[1]);
+    }
+
+    fn eager(g: *Graphs, count: *u64, first: *?[]const u8, kind: []const u8, why: []const u8) void {
+        count.* += 1;
+        if (first.* != null) return;
+        first.* = why;
+        std.log.info("glm graphs rank {d}: {s} eager: {s} (the first; counts follow in the graphs line)", .{ g.rank, kind, why });
+    }
+
+    fn admit(g: *Graphs, state: usize) void {
+        for (g.slots[0..g.nslots]) |s| if (s == state) return;
+        if (g.nslots == max_slots) return;
+        g.slots[g.nslots] = state;
+        g.nslots += 1;
+        const cap = cappedVerify(g.nslots, g.rows, g.max_verify);
+        if (g.verify.settings.max == 0) return;
+        if (g.verify.cap == g.verify.settings.max) g.verify.cap = cap;
+        g.verify.settings.max = cap;
+    }
+
+    fn note(g: *Graphs, out: gc.Outcome, capture_mib: f64) void {
+        if (out == .captured) g.mib += capture_mib;
+        g.steps += 1;
+        if ((g.steps >= 64 and g.steps & (g.steps - 1) == 0) or g.steps % 8192 == 0) g.report();
+    }
+
+    pub fn report(g: *const Graphs) void {
+        const d = g.draft.stats;
+        const v = g.verify.stats;
+        std.log.info("glm graphs rank {d}: {d} steps; draft {d} captured, {d} replayed, {d} eager; verify {d} captured, {d} replayed, {d} eager ({d} slots, cap {d}); captures {d:.0} MiB; {d} floor hits ({d:.1} GiB)", .{
+            g.rank, g.steps, d.captured, d.replayed, d.eager + g.stats.draft_eager, v.captured, v.replayed, v.eager + g.stats.verify_eager, g.nslots, g.verify.cap, g.mib, d.floor_hits + v.floor_hits, floor_gib,
+        });
+        if (g.shared_verify) |sv| std.log.info("glm graphs rank {d}: shared verify {d} captured, {d} replayed, {d} eager, {d} evicted (cap {d})", .{ g.rank, sv.stats.captured, sv.stats.replayed, sv.stats.eager + g.stats.shared_eager, sv.stats.evicted, sv.cap });
+        if (g.block) |b| std.log.info("glm graphs rank {d}: drafter {d} captured, {d} replayed, {d} eager ({d} past graphed sizes)", .{ g.rank, b.stats.captured, b.stats.replayed, b.stats.eager + g.block_eager, g.block_eager });
+    }
+
+    fn copy(f: anytype, dst: u64, src: u64, bytes: usize) !void {
+        try f.d.check(f.d.api.cuMemcpyDtoDAsync_v2(dst, src, bytes, f.stream.handle), "cuMemcpyDtoDAsync");
+    }
+
+    fn snap(g: *Graphs, f: anytype, which: usize, outs: []const [2]u64) !void {
+        const c = g.check.?;
+        var at = c.dev.ptr + c.keep + which * c.half;
+        for (outs) |o| {
+            if (o[1] == 0) continue;
+            try copy(f, at, o[0], o[1]);
+            at += o[1];
+        }
+    }
+
+    fn compare(g: *Graphs, f: anytype, what: []const u8, pos: usize, key: anytype, split: usize, split2: usize, n: usize) !void {
+        const c = g.check.?;
+        const d = f.d;
+        try d.check(d.api.cuMemcpyDtoHAsync_v2(c.host.bytes.ptr, c.dev.ptr + c.keep, c.half, f.stream.handle), "cuMemcpyDtoHAsync");
+        try d.check(d.api.cuMemcpyDtoHAsync_v2(c.host.bytes.ptr + c.half, c.dev.ptr + c.keep + c.half, c.half, f.stream.handle), "cuMemcpyDtoHAsync");
+        try f.stream.synchronize();
+        const a = c.host.bytes[0..n];
+        const b = c.host.bytes[c.half..][0..n];
+        g.stats.checked += 1;
+        if (std.mem.indexOfDiff(u8, a, b)) |at| {
+            g.stats.differed += 1;
+            std.log.err("glm graphs check: {s} at {d} (key {any}) differs from eager at byte {d} of {d} ({s}); {d} of {d} checked differ", .{ what, pos, key, at, n, if (split2 == 0) "outputs" else if (at < split) "logits" else if (at < split2) "hidden" else "taps", g.stats.differed, g.stats.checked });
+        } else if (g.stats.checked & (g.stats.checked - 1) == 0) {
+            const sv_cap = if (g.shared_verify) |sv| sv.stats.captured else 0;
+            const sv_rep = if (g.shared_verify) |sv| sv.stats.replayed else 0;
+            std.log.info("glm graphs check: {d} steps graph = eager bit for bit (verify {d}/{d}; shared {d}/{d})", .{ g.stats.checked, g.verify.stats.captured, g.verify.stats.replayed, sv_cap, sv_rep });
+        }
+    }
+};
