+    /// Host-side prep for a graphed 1-row MTP draft step: readyMtp (may rebase) + ids upload.
+    pub fn mtpReady(f: *const Forward, r: Rank, ids: []const i32) !void {
+        if (r.w.mtp == null) return error.NoMtpHead;
+        if (ids.len != 1 or r.b.rows == 0) return error.BadWindow;
+        try r.st.readyMtp(f.stream, 1);
