+
+    /// Pure device launches of a 1-row MTP draft step (non-prefill, no image splice) for CUDA graph capture.
+    pub fn mtpGraphed(f: *const Forward, hidden: u64) !void {
+        const c = &f.ranks[0].w.config;
+        const D: usize = c.hidden;
+        const r = f.ranks[0];
+        const m = r.w.mtp.?;
+        const b = r.b;
+        if (hidden != b.hin) try f.d.check(f.d.api.cuMemcpyDtoDAsync_v2(b.hin, hidden, D * 2, f.stream.handle), "cuMemcpyDtoDAsync");
+        try glue.embedB16(f.set(), f.stream, b.ids, r.w.embed, b.me, 1, D, 1);
+        if (r.st.mtp_len == 0) try f.d.check(f.d.api.cuMemsetD8Async(b.me, 0, D * 2, f.stream.handle), "cuMemsetD8Async");
+        try glue.rmsnorm(f.set(), f.stream, b.me, D, m.enorm, b.mcat, 2 * D, null, c.eps, 1, D);
+        try glue.rmsnorm(f.set(), f.stream, b.hin, D, m.hnorm, b.mcat + D * 2, 2 * D, null, c.eps, 1, D);
+        try b16.matmul(f.set(), f.stream, b.mcat, 2 * D, m.eh, b.mx, b.kda.mm_part, 1, D, 2 * D, false);
+        try glue.rmsnormBy(f.set(), f.stream, b.mx, D, m.layer.in_norm, b.normed, D, b.xs, c.eps, 1, D);
+        const nch = @min(latent.chunksFor(r.st.mtp_len + 1), b.nch);
+        const k: dsa_block.Kernels = .{ .set = f.set(), .ops = f.m.ops() };
+        try dsa_block.block(k, f.stream, m.layer.mixer.mla, r.st.mtp_caches, b.dsa, b.normed, D, 1, r.st.mtp_pos_dev, r.st.mtp_len, nch, b.part_rows, slot(r, 1));
+        try f.resolve(1);
+        try glue.residualAdd(f.set(), f.stream, b.mx, b.mx, b.gathered, 1, D, r.w.share.world);
+        try glue.rmsnormBy(f.set(), f.stream, b.mx, D, m.layer.post_norm, b.normed, D, b.xs, c.eps, 1, D);
+        try f.ffn(r, m.layer, 1, slot(r, 1));
+        try f.resolve(1);
+        try glue.residualAdd(f.set(), f.stream, b.mx, b.mx, b.gathered, 1, D, r.w.share.world);
+        try glue.rmsnorm(f.set(), f.stream, b.mx, D, m.norm, b.fnormed, D, b.fxs, c.eps, 1, D);
+        try q4.matmul(&f.m.q4, f.stream, b.fnormed, D, b.fxs, m.draft, b.logits, 1);
+    }
