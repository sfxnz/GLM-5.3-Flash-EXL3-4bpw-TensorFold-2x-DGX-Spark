From 234e76d0f3a205bfbbd4a9a832da400ad57a07d9 Mon Sep 17 00:00:00 2001
From: local <local@x>
Date: Fri, 20 Nov 2026 17:25:54 +0200
Subject: [PATCH 15/39] glm cuda: an E4M3 cache's token lists stay positions:
 the pooled keys' table carries the latent table's logical flag

---
 zig/src/families/glm/cuda_dsa_block.zig | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/zig/src/families/glm/cuda_dsa_block.zig b/zig/src/families/glm/cuda_dsa_block.zig
index 186cf82ea..13337b45b 100644
--- a/zig/src/families/glm/cuda_dsa_block.zig
+++ b/zig/src/families/glm/cuda_dsa_block.zig
@@ -288,7 +288,8 @@ fn tables(l: Layer, c: Caches) !struct { latent.Table, latent.Table } {
     if (c.ps % (l.lw * 2) != 0 or c.latPs() % (l.lw * 2) != 0) return error.LatentShape; // pages whole latent rows apart (the token lists' unit)
     // an E4M3 cache's sparse lists stay positions (its chunks take each key through the table); BF16's are page rows
     const t: latent.Table = .{ .pt = c.pt, .ps = c.ps, .page_rows = c.ps / (l.lw * 2), .logical = c.ls != 0 };
-    return .{ t, .{ .pt = c.pt, .ps = if (c.pks != 0) c.pks else c.ps, .page_rows = t.page_rows } };
+    // the pooled keys' table decides how tf_glm_dsa_tokens writes the lists, so it carries the latent table's units too
+    return .{ t, .{ .pt = c.pt, .ps = if (c.pks != 0) c.pks else c.ps, .page_rows = t.page_rows, .logical = t.logical } };
 }
 
 /// The latent rows' table (`tables`[0] but through Caches.latPt/latPs: the same unsharded).
