+/// TF_GLM_FAST_LOAD (default off): parallel pinned-staged EXL3 upload, rank-filtered prefetch, and GPU dense qtile.
+pub fn fastLoad() !bool {
+    return @import("sys").environment.read(bool, "TF_GLM_FAST_LOAD", false);
+}
+
+const GatherCtx = struct {
+    slices: []const []const u8,
+    dst: []u8,
+    kt: usize,
+    nt: usize,
+    by_cols: bool,
+    m_n: usize,
+    cut_lo: usize,
+    tb: usize,
+    per_expert: usize,
+};
+
+fn gatherRange(ctx: GatherCtx, lo: usize, hi: usize) void {
+    const dst_row = ctx.nt * ctx.tb;
+    const src_row = (ctx.m_n / 16) * ctx.tb;
+    const col_off = (ctx.cut_lo / 16) * ctx.tb;
+    const down_off = (ctx.cut_lo / 16) * ctx.nt * ctx.tb;
+    for (lo..hi) |e| {
+        const src = ctx.slices[e];
+        const out = ctx.dst[e * ctx.per_expert ..][0..ctx.per_expert];
+        if (ctx.by_cols) {
+            for (0..ctx.kt) |r| {
+                @memcpy(out[r * dst_row ..][0..dst_row], src[r * src_row + col_off ..][0..dst_row]);
+            }
+        } else {
+            @memcpy(out[0..ctx.per_expert], src[down_off..][0..ctx.per_expert]);
+        }
+    }
+}
+
+fn uploadTrellisFast(L: anytype, comptime tw: []const u8, i: u32, slices: []const []const u8, kt: usize, nt: usize, by_cols: bool, m_n: usize, cut_lo: usize, tb: usize) !u64 {
+    const count = slices.len;
+    const per_expert = kt * nt * tb;
+    const total = count * per_expert;
+    const dev = try cuda.DeviceBuffer.alloc(L.d, total);
+    const base = try @import("cuda_upload_owner.zig").keep(L, dev, "layers.{d}.moe.exl3." ++ tw, .{i});
+    if (count == 0) return base;
+    const staging_cap = @import("cuda_load_pack.zig").staging_bytes;
+    const piece_experts = @max(@as(usize, 1), @min(count, staging_cap / per_expert));
+    const piece_bytes = piece_experts * per_expert;
+    if (L.staging.buf) |b| if (b.bytes.len < piece_bytes) L.staging.deinit();
+    if (L.staging.buf == null) L.staging.buf = try cuda.HostBuffer.allocMapped(L.d, piece_bytes);
+    const dst_host = L.staging.buf.?.bytes;
+    const dst_dev = try L.staging.buf.?.device();
+    errdefer L.stream.synchronize() catch {};
+    const max_threads: usize = 12;
+    var first: usize = 0;
+    while (first < count) : (first += piece_experts) {
+        const k = @min(piece_experts, count - first);
+        const n = @max(@as(usize, 1), @min(max_threads, k));
+        const ctx: GatherCtx = .{
+            .slices = slices[first..][0..k],
+            .dst = dst_host[0 .. k * per_expert],
+            .kt = kt,
+            .nt = nt,
+            .by_cols = by_cols,
+            .m_n = m_n,
+            .cut_lo = cut_lo,
+            .tb = tb,
+            .per_expert = per_expert,
+        };
+        var spawned: [max_threads]?std.Thread = @splat(null);
+        for (1..n) |t| {
+            const lo = k * t / n;
+            const hi = k * (t + 1) / n;
+            spawned[t] = std.Thread.spawn(.{}, gatherRange, .{ ctx, lo, hi }) catch null;
+        }
+        gatherRange(ctx, 0, k / n);
+        for (spawned[1..n], 1..) |thread, t| {
+            if (thread) |x| x.join() else gatherRange(ctx, k * t / n, k * (t + 1) / n);
+        }
+        try dev.copyFrom(first * per_expert, dst_dev, k * per_expert, L.stream.handle);
+        try L.stream.synchronize();
+    }
+    return base;
+}
