@@ -1,8 +1,58 @@
 //! Read-only layer prefetch through core; uploads and page drops retain their loader's order.
 const std = @import("std");
 const core = @import("core");
+const Span = @import("cuda_shard.zig").Span;
+
 pub fn begin(ck: *const core.Checkpoint, i: usize, count: usize) !core.checkpoint_read_ahead.Scope {
     if (count == 0) return .{};
     var buf: [160]u8 = undefined;
     return core.checkpoint_read_ahead.checkpoint(ck, try std.fmt.bufPrint(&buf, "model.language_model.layers.{d}.", .{i}), count);
 }
+
+fn lower(_: void, x: [2]u64, y: [2]u64) bool {
+    return x[0] < y[0];
+}
+
+/// Rank-filtered prefetch (TF_GLM_FAST_LOAD): skips the other rank's contiguous half of EXL3 down_proj.trellis.
+pub fn beginForRank(ck: *const core.Checkpoint, i: usize, count: usize, moe_cut: Span, moe_inter: usize) !core.checkpoint_read_ahead.Scope {
+    if (count == 0) return .{};
+    const fast = try @import("cuda_exl3.zig").fastLoad();
+    if (!fast or moe_inter == 0 or (moe_cut.lo == 0 and moe_cut.hi >= moe_inter)) return begin(ck, i, count);
+    var buf: [160]u8 = undefined;
+    const prefix = try std.fmt.bufPrint(&buf, "model.language_model.layers.{d}.", .{i});
+    const gpa = ck.gpa;
+    var out: std.ArrayList(core.checkpoint_read_ahead.Span) = .empty;
+    errdefer out.deinit(gpa);
+    var ranges: std.ArrayList([2]u64) = .empty;
+    defer ranges.deinit(gpa);
+    const chunk = core.checkpoint_read_ahead.chunk;
+    for (ck.files.items) |*f| {
+        if (f.map.section == null) continue;
+        ranges.clearRetainingCapacity();
+        var it = f.names.iterator();
+        while (it.next()) |e| {
+            const name = e.key_ptr.*;
+            if (!std.mem.startsWith(u8, name, prefix)) continue;
+            var lo: u64 = f.data + e.value_ptr.begin;
+            var hi: u64 = f.data + e.value_ptr.end;
+            if (std.mem.endsWith(u8, name, ".down_proj.trellis") and hi > lo) {
+                const len = hi - lo;
+                const sub_lo = len * moe_cut.lo / moe_inter;
+                const sub_hi = len * moe_cut.hi / moe_inter;
+                lo += sub_lo;
+                hi = lo + (sub_hi - sub_lo);
+            }
+            if (hi > lo) try ranges.append(gpa, .{ lo, hi });
+        }
+        std.mem.sort([2]u64, ranges.items, {}, lower);
+        var k: usize = 0;
+        while (k < ranges.items.len) {
+            var lo, var hi = ranges.items[k];
+            k += 1;
+            while (k < ranges.items.len and ranges.items[k][0] <= hi) : (k += 1) hi = @max(hi, ranges.items[k][1]);
+            while (lo < hi) : (lo = @min(lo + chunk, hi)) try out.append(gpa, .{ .path = f.path, .lo = lo, .hi = @min(lo + chunk, hi) });
+        }
+    }
+    const spans = try out.toOwnedSlice(gpa);
+    return .{ .reader = try core.checkpoint_read_ahead.start(gpa, ck.io, spans, count) };
+}
