+/// A row-major bf16 [n][k] linear at `src` quantized to `bits` and tiled on GPU into `dst` + `ds` (TF_GLM_FAST_LOAD).
+pub fn qtile(k: *const Kernels, s: cuda.Stream, bits: u8, src: u64, dst: u64, ds: u64, n: usize, kk: usize) !void {
+    const wi = try widthIndex(bits);
+    if (wi == 0) return error.BadBits;
+    const chunks = n / 8 * (kk / 64) * 32;
+    var a: cuda.Args = .{};
+    a.add(src);
+    a.add(dst);
+    a.add(ds);
+    a.add(@as(c_int, @intCast(n)));
+    a.add(@as(c_int, @intCast(kk)));
+    try cuda.launch.launch(k.qtile_packed[wi - 1], .{ .grid = .{ .x = @intCast((chunks + 255) / 256) }, .block = .{ .x = 256 } }, s, &a);
+}
