index f6e1821c9..ce6511d59 100644
--- a/zig/kernels/cuda/glm_mm.cu
+++ b/zig/kernels/cuda/glm_mm.cu
@@ -383,6 +383,51 @@ extern "C" __global__ void glm_mm_tile8(const uint32_t* src, const __half* ss, u
     tile_packed<8>(src, ss, dst, ds, N, K);
 }
 
+// -- quantize + tile on GPU (TF_GLM_FAST_LOAD): bf16 rows [N][K] -> symmetric BITS-bit tiled chunks + fp16 scales --
+// Bit-identical to cuda_qpack.quantize + tile_packed<BITS>: lanes (lane & 3 == 0..3) partition row n's 64-element group.
+template <int BITS>
+__device__ __forceinline__ void qtile_bf16(const __nv_bfloat16* __restrict__ src,
+                                           uint32_t* __restrict__ dst, __half* __restrict__ ds, int N, int K) {
+    constexpr int WPC = BITS / 2;
+    constexpr int HALF = 1 << (BITS - 1);
+    constexpr float QMAX = (float)(HALF - 1);
+    const int KG = K >> 6, N8 = N >> 3;
+    const long long c = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+    if (c >= (long long)N8 * KG * 32) return;
+    const int lane = (int)(c & 31);
+    const long long tg = c >> 5;
+    const int g = (int)(tg % KG), tt = (int)(tg / KG);
+    const int n = tt * 8 + (lane >> 2);
+    const __nv_bfloat16* row = src + (long long)n * K + g * 64;
+    float vals[16];
+    float amax = 0.0f;
+#pragma unroll
+    for (int v = 0; v < 16; ++v) {
+        vals[v] = __bfloat162float(row[frag_k(lane, v)]);
+        amax = fmaxf(amax, fabsf(vals[v]));
+    }
+    amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, 1));
+    amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, 2));
+    const __half s16 = __float2half_rn(__fdiv_rn(amax, QMAX));
+    const float sc = __half2float(s16);
+    int q[16];
+#pragma unroll
+    for (int v = 0; v < 16; ++v) {
+        if (sc == 0.0f) {
+            q[v] = 0;
+        } else {
+            const float r = rintf(__fdiv_rn(vals[v], sc));
+            q[v] = (int)fmaxf(-QMAX, fminf(QMAX, r));
+        }
+    }
+    pack16<BITS>(q, dst + c * WPC);
+    if ((lane & 3) == 0) ds[(tg * 8) + (lane >> 2)] = s16;
+}
+
+extern "C" __global__ void glm_mm_qtile4(const __nv_bfloat16* src, uint32_t* dst, __half* ds, int N, int K) { qtile_bf16<4>(src, dst, ds, N, K); }
+extern "C" __global__ void glm_mm_qtile6(const __nv_bfloat16* src, uint32_t* dst, __half* ds, int N, int K) { qtile_bf16<6>(src, dst, ds, N, K); }
+extern "C" __global__ void glm_mm_qtile8(const __nv_bfloat16* src, uint32_t* dst, __half* ds, int N, int K) { qtile_bf16<8>(src, dst, ds, N, K); }
+
