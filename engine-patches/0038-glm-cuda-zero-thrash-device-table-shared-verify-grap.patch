+// Device-table variants for zero-thrash shared verify CUDA graphs.
+extern "C" __global__ void __launch_bounds__(256)
+    tf_glm_chunks_16_fp8_paged_segs_ptr(int64_t heads, int64_t w, float scale, int sparse, int64_t pstep,
+                                        const glm_attn::AttnSegs* tp) {
+  glm_pdl::enter();
+  const glm_attn::AttnSeg& g = glm_attn::seg_of(*tp, static_cast<int>(blockIdx.x));
+  const int64_t c = blockIdx.z;
+  if (c >= g.nch) return;
+  glm_attn::chunks_wide<16, true, 0, false, true>(g.qa, reinterpret_cast<const __nv_bfloat16*>(g.lc), g.pos, g.tok,
+                                                  g.cnt, g.po, g.pm, g.pl, g.rows, heads, w, scale, sparse, g.pt, pstep,
+                                                  g.scales, 1, 0, static_cast<int64_t>(blockIdx.x) - g.row0, c);
+}
+
+extern "C" __global__ void __launch_bounds__(128)
+    tf_glm_merge_segs_ptr(int64_t heads, int sparse, const glm_attn::AttnSegs* tp) {
+  glm_pdl::enter();
+  const glm_attn::AttnSeg& g = glm_attn::seg_of(*tp, static_cast<int>(blockIdx.x));
+  glm_attn::merge_body(g.po, g.pm, g.pl, g.out, g.cnt, g.rows, heads, g.nch, sparse,
+                       static_cast<int64_t>(blockIdx.x) - g.row0);
+}
