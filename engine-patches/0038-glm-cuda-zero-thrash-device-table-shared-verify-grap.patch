+
+// Device-table variants for zero-thrash shared verify CUDA graphs: segment descriptors (including KDA state_in/out
+// ping-pong parities and per-stream row counts) are uploaded once per round before graph replay.
+extern "C" __global__ void __launch_bounds__(512) tf_glm_kda_prep_segs_ptr(
+        int H, int p_stride, int b_off, int a_stride, const float* __restrict__ cw, const float* __restrict__ a_log,
+        const float* __restrict__ dt_bias, float lower, const KdaSegs* tp) {
+    glm_pdl::enter();
+    const KdaSeg& g = tp->s[blockIdx.z];
+    if (static_cast<int>(blockIdx.x) >= g.rows) return;
+    prep_kernel_body(H, g.P, p_stride, b_off, g.A, a_stride, g.cs, cw, a_log, dt_bias, lower, g.q, g.k_save, g.v_save,
+                     g.g_save, g.b_save);
+}
+
+extern "C" __global__ void __launch_bounds__(256) tf_glm_kda_step_segs_ptr(int H, const KdaSegs* tp) {
+    glm_pdl::enter();
+    const KdaSeg& g = tp->s[blockIdx.z];
+    step_kernel_body<8, 16>(H, g.state_in, g.q, g.k_save, g.v_save, g.g_save, g.b_save, g.rows, g.y, g.state_out);
+}
+
+extern "C" __global__ void __launch_bounds__(128) tf_glm_kda_out_segs_ptr(
+        int H, int g_stride, const __nv_bfloat16* __restrict__ norm_w, float eps, const KdaSegs* tp) {
+    glm_pdl::enter();
+    const KdaSeg& g = tp->s[blockIdx.z];
+    if (static_cast<int>(blockIdx.x) >= g.rows) return;
+    out_kernel_body(H, g.y, g.G, g_stride, norm_w, eps, g.out);
+}
