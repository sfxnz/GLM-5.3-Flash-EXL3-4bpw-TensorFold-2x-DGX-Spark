+            switch (rl) {
+                .local => {
+                    entries += 1;
+                    attn_rows += g.rows;
+                },
+                .take => {
+                    entries += 2;
+                    take_rows += g.rows;
+                    attn_rows += 2 * g.rows;
+                },
+                .give => {
+                    give_rows += g.rows;
+                },
+            }
+        }
+        if (entries > latent.max_segs or attn_rows * b.part_chunks > b.dsa.partials.rows) return;
+        if (f.kv) |kv| {
+            if (give_rows + give_pack_row_off > kv.rows or take_rows > give_pack_row_off) return;
+        }
