+// Device-table variants for zero-thrash shared verify CUDA graphs.
+extern "C" __global__ void __launch_bounds__(512)
+    tf_glm_lat_write_fp8_paged_segs_ptr(int64_t stride, int64_t lat_ps, const glm_wsegs::Segs* tp) {
+  glm_pdl::enter();
+  const glm_wsegs::Seg& g = glm_wsegs::by_row(*tp, static_cast<int>(blockIdx.x));
+  glm_latw::write_fp8_paged(g.lat, stride, g.cache, g.scales, g.pos, g.lpt, lat_ps,
+                            static_cast<int64_t>(blockIdx.x) - g.row0);
+}
+extern "C" __global__ void __launch_bounds__(32)
+    tf_glm_index_write_segs_ptr(int64_t k_stride, const __nv_bfloat16* lnw, const __nv_bfloat16* lnb, float eps,
+                                const glm_wsegs::Segs* tp) {
+  glm_pdl::enter();
+  const glm_wsegs::Seg& g = glm_wsegs::by_row(*tp, static_cast<int>(blockIdx.x));
+  glm_idxw::index_write(g.kr, k_stride, g.gr, lnw, lnb, g.ik, g.ig, g.pos, eps,
+                        static_cast<int64_t>(blockIdx.x) - g.row0);
+}
+extern "C" __global__ void __launch_bounds__(32)
+    tf_glm_pool_keys_segs_ptr(const __nv_bfloat16* ape, int64_t pk_ps, const glm_wsegs::Segs* tp) {
+  glm_pdl::enter();
+  const glm_wsegs::Seg& g = glm_wsegs::by_block(*tp, static_cast<int>(blockIdx.x));
+  const int64_t rel = static_cast<int64_t>(blockIdx.x) - g.b0;
+  if (rel < 0 || rel >= g.rows / 4 + 2) return;
+  glm_idxw::pool_keys(g.ik, g.ig, ape, g.pk, g.pos, g.rows, g.pt, pk_ps, rel);
+}
+extern "C" __global__ void __launch_bounds__(256) tf_glm_copy_segs_ptr(const tf_glm_copies* tp) {
+  glm_pdl::enter();
+  const tf_glm_copy& c = tp->c[blockIdx.y];
+  for (int64_t i = (int64_t)blockIdx.x * blockDim.x + threadIdx.x; i < c.n; i += (int64_t)gridDim.x * blockDim.x)
+    c.dst[i] = c.src[i];
+}
