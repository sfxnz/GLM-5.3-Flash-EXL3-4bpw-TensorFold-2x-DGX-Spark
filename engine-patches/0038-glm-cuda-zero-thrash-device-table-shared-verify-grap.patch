+        // Fill KDA per-layer tables.
+        const copies_arr = t.hostSlice(glue.Copies, t.off_copies, t.kda_layers);
+        const kda_arr = t.hostSlice(kda.Segs, t.off_kda, t.kda_layers);
+        const writes_arr = t.hostSlice(dsa_block.WriteSegs, t.off_writes, t.mla_layers);
+        const attns_arr = t.hostSlice(latent.AttnSegs, t.off_attns, t.mla_layers);
+
+        var li: usize = 0;
+        var di: usize = 0;
+        var kind_all: ?dsa_block.SegsKind = null;
+        var ps0_all: u64 = 0;
+        var lat_ps0_all: u64 = 0;
+        var max_nch_all: usize = 0;
+        var rb_all: usize = 0;
+
+        for (r.w.layers) |l| {
+            switch (l.mixer) {
+                .kda => |k| {
+                    const hd = k.heads * kda.dk;
+                    const w = k.matWidth();
+                    const s = b.kda;
+                    var cp: glue.Copies = std.mem.zeroes(glue.Copies);
+                    var ks: kda.Segs = std.mem.zeroes(kda.Segs);
+                    for (r.segs, 0..) |g, i| {
+                        const st = g.st;
+                        const cur = st.cur[li];
+                        const p_dst = st.proj + li * st.proj_layer * 2;
+                        const p_src = b.kproj + g.row0 * w * 2;
+                        const bytes = g.rows * w * 2;
+                        if (!glue.copyFits(p_src, p_dst, bytes)) return;
+                        cp.c[i] = .{ .src = p_src, .dst = p_dst, .n = @intCast(bytes / 16) };
+                        const kv_off = li * fw.window_rows * st.heads * kda.dk;
+                        ks.s[i] = .{
+                            .p = p_dst,
+                            .a = s.ka + g.row0 * hd * 2,
+                            .g = s.kg + g.row0 * hd * 2,
+                            .cs = st.conv + li * 3 * st.conv_c * 2,
+                            .state_in = st.recAt(cur, li),
+                            .state_out = st.recAt(1 - cur, li),
+                            .q = s.wide.q + g.row0 * hd * 4,
+                            .k = st.save_k + kv_off * 4,
+                            .v = st.save_v + kv_off * 2,
+                            .gs = st.save_g + kv_off * 4,
+                            .b = st.save_b + li * fw.window_rows * st.heads * 4,
+                            .y = s.wide.y + g.row0 * hd * 2,
+                            .out = s.saves.out + g.row0 * hd * 2,
+                            .rows = @intCast(g.rows),
+                        };
+                    }
+                    copies_arr[li] = cp;
+                    kda_arr[li] = ks;
+                    li += 1;
+                },
+                .mla => |a| {
+                    const rb = kv_attn.rowBytes(a);
+                    if (di == 0) rb_all = rb else if (rb != rb_all) return;
+                    var caches: [latent.max_segs]dsa_block.Caches = undefined;
+                    var host_pos: [latent.max_segs]usize = undefined;
+                    var seg_rows: [latent.max_segs]usize = undefined;
+                    const ps0 = r.segs[0].st.caches[di].ps;
+                    const lat_ps0 = r.segs[0].st.caches[di].latPs();
+                    if (di == 0) {
+                        ps0_all = ps0;
+                        lat_ps0_all = lat_ps0;
+                    } else if (ps0 != ps0_all or lat_ps0 != lat_ps0_all) return;
+                    for (r.segs, 0..) |g, i| {
+                        caches[i] = g.st.caches[di];
+                        host_pos[i] = g.st.pos;
+                        seg_rows[i] = g.rows;
+                        if (caches[i].ps != ps0 or caches[i].latPs() != lat_ps0) return;
+                    }
+                    const kind = dsa_block.segsKind(a, caches[0..n], host_pos[0..n], seg_rows[0..n]) orelse return;
+                    if (kind_all) |prev| {
+                        if (prev != kind) return;
+                    } else {
+                        kind_all = kind;
+                    }
+
+                    var wt: dsa_block.WriteSegs = std.mem.zeroes(dsa_block.WriteSegs);
+                    wt.n = @intCast(n);
+                    var blocks: usize = 0;
+                    for (r.segs, 0..) |g, i| {
+                        wt.s[i] = dsa_block.writeSeg(a, caches[i], dsa_block.attendScratch(a, b.dsa, g.row0), g.st.pos_dev, g.rows, g.row0, blocks) catch return;
+                        blocks += dsa_block.poolBlocks(g.rows);
+                    }
+                    writes_arr[di] = wt;
+
+                    var at: latent.AttnSegs = std.mem.zeroes(latent.AttnSegs);
+                    var ai: usize = 0;
+                    var arow: usize = 0;
+                    var take_off: usize = 0;
+                    for (r.segs, 0..) |g, i| {
+                        if (roles[i] == .give) continue;
+                        const v = dsa_block.attendScratch(a, b.dsa, g.row0);
+                        const tok = b.dsa.tokens + g.row0 * sparse.width * 4;
+                        const cnt = b.dsa.counts + g.row0 * 4;
+                        const seg_nch: usize = if (kind == .dense) @min(latent.chunksFor(g.st.pos + g.rows), b.nch) else latent.chunksFor(sparse.width);
+                        max_nch_all = @max(max_nch_all, seg_nch);
+                        const p_own = b.part_chunks * arow * a.heads;
+                        at.s[ai] = .{
+                            .qa = v.qa,
+                            .lc = caches[i].lc,
+                            .scales = caches[i].ls,
+                            .pos = if (kind == .dense) g.st.pos_dev else 0,
+                            .tok = if (kind == .sparse) tok else 0,
+                            .cnt = if (kind == .sparse) cnt else 0,
+                            .po = b.dsa.partials.po + p_own * a.lw * 4,
+                            .pm = b.dsa.partials.pm + p_own * 4,
+                            .pl = b.dsa.partials.pl + p_own * 4,
+                            .pt = caches[i].latPt(),
+                            .out = v.ol,
+                            .rows = @intCast(g.rows),
+                            .nch = @intCast(seg_nch),
+                            .row0 = @intCast(arow),
+                        };
+                        ai += 1;
+                        arow += g.rows;
+                        if (roles[i] == .take) {
+                            const kv = f.kv.?;
+                            const p_peer = b.part_chunks * arow * a.heads;
+                            at.s[ai] = .{
+                                .qa = kv.pq + take_off * rb,
+                                .lc = caches[i].lc,
+                                .scales = caches[i].ls,
+                                .pos = if (kind == .dense) g.st.pos_dev else 0,
+                                .tok = if (kind == .sparse) tok else 0,
+                                .cnt = if (kind == .sparse) cnt else 0,
+                                .po = b.dsa.partials.po + p_peer * a.lw * 4,
+                                .pm = b.dsa.partials.pm + p_peer * 4,
+                                .pl = b.dsa.partials.pl + p_peer * 4,
+                                .pt = caches[i].latPt(),
+                                .out = kv.po + take_off * rb,
+                                .rows = @intCast(g.rows),
+                                .nch = @intCast(seg_nch),
+                                .row0 = @intCast(arow),
+                            };
+                            ai += 1;
+                            arow += g.rows;
+                            take_off += g.rows;
+                        }
+                    }
+                    at.n = @intCast(ai);
+                    attns_arr[di] = at;
+                    di += 1;
+                },
+            }
+        }
+
+        // Build contiguous .give pack/unpack tables (identical across all MLA layers).
+        const pack_ptr = &t.hostSlice(glue.Copies, t.off_pack_qa, 1)[0];
+        const unpack_ptr = &t.hostSlice(glue.Copies, t.off_unpack_ol, 1)[0];
+        pack_ptr.* = std.mem.zeroes(glue.Copies);
+        unpack_ptr.* = std.mem.zeroes(glue.Copies);
+        if (give_rows > 0 and t.mla_layers > 0) {
+            const kv = f.kv.?;
+            const gq = giveQaBuf(kv, rb_all);
+            const go = giveOlBuf(kv, rb_all);
+            var g_off: usize = 0;
+            for (r.segs, 0..) |g, i| {
+                if (roles[i] != .give) continue;
+                const bytes = g.rows * rb_all;
+                const qa_src = b.dsa.qa + g.row0 * rb_all;
+                const ol_dst = b.dsa.ol + g.row0 * rb_all;
+                const gq_dst = gq + g_off * rb_all;
+                const go_src = go + g_off * rb_all;
+                if (!glue.copyFits(qa_src, gq_dst, bytes) or !glue.copyFits(go_src, ol_dst, bytes)) return;
+                pack_ptr.c[i] = .{ .src = qa_src, .dst = gq_dst, .n = @intCast(bytes / 16) };
+                unpack_ptr.c[i] = .{ .src = go_src, .dst = ol_dst, .n = @intCast(bytes / 16) };
+                g_off += g.rows;
+            }
+        }
+
+        // One async H2D DMA of the entire 45-layer descriptor table before graph replay.
+        try t.d.check(t.d.api.cuMemcpyHtoDAsync_v2(t.dev.ptr, t.host.bytes.ptr, t.total_bytes, f.stream.handle), "cuMemcpyHtoDAsync");
+
+        t.segs = @intCast(n);
+        t.max_seg_bucket = @intCast(bucket);
+        t.give_rows = @intCast(give_rows);
+        t.take_rows = @intCast(take_rows);
+        t.attn_rows = @intCast(attn_rows);
+        t.max_nch = @intCast(max_nch_all);
+        t.pool_blocks = @intCast(n * (bucket / 4 + 2));
+        t.kind = kind_all orelse .dense;
+        t.lat_ps0 = lat_ps0_all;
+        t.pk_ps0 = ps0_all;
+        t.rb = rb_all;
+        t.valid = true;
+    }
+};
+
+test "shared table: row bucketing collapses small variations to {4, 8, 16}" {
+    try std.testing.expectEqual(@as(usize, 4), bucketRows(1));
+    try std.testing.expectEqual(@as(usize, 4), bucketRows(4));
+    try std.testing.expectEqual(@as(usize, 8), bucketRows(5));
+    try std.testing.expectEqual(@as(usize, 8), bucketRows(8));
+    try std.testing.expectEqual(@as(usize, 16), bucketRows(12));
+    try std.testing.expectEqual(@as(usize, 24), bucketRows(24));
+}
