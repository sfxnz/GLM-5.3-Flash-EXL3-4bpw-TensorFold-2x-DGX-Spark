+/// Device-table variant of chainSegs for zero-thrash shared verify CUDA graphs: `segs_dev` points to a device Segs.
+pub fn chainSegsPtr(ks: *const Kernels, stream: cuda.Stream, c: Chain, segs_dev: u64, n: usize, most: usize) !void {
+    const prep_segs = ks.prep_segs_ptr orelse return error.FormatNotLoaded;
+    const step_segs = ks.step_segs_ptr orelse return error.FormatNotLoaded;
+    const out_segs = ks.out_segs_ptr orelse return error.FormatNotLoaded;
+    if (n == 0 or n > max_segs) return error.TooManySegments;
+    if (most == 0) return;
+    const h: c_int = @intCast(c.heads);
+    const z: u32 = @intCast(n);
+    var a: cuda.Args = .{};
+    a.add(h);
+    a.add(@as(c_int, @intCast(c.p_stride)));
+    a.add(@as(c_int, @intCast(c.b_off)));
+    a.add(@as(c_int, @intCast(c.a_stride)));
+    for ([_]u64{ c.conv_w, c.a_log, c.dt_bias }) |v| a.add(v);
+    a.add(c.lower);
+    a.add(segs_dev);
+    try cuda.launch.launch(prep_segs, .{ .grid = .{ .x = @intCast(most), .y = @intCast(c.heads), .z = z }, .block = .{ .x = 512 }, .pdl = ks.pdl }, stream, &a);
+    var b: cuda.Args = .{};
+    b.add(h);
+    b.add(segs_dev);
+    try cuda.launch.launch(step_segs, .{ .grid = .{ .x = @intCast(c.heads), .y = dv / 4 / 8, .z = z }, .block = .{ .x = 8 * 32 }, .pdl = ks.pdl }, stream, &b);
+    var o: cuda.Args = .{};
+    o.add(h);
+    o.add(@as(c_int, @intCast(c.g_stride)));
+    o.add(c.norm_w);
+    o.add(c.eps);
+    o.add(segs_dev);
+    try cuda.launch.launch(out_segs, .{ .grid = .{ .x = @intCast(most), .y = @intCast(c.heads), .z = z }, .block = .{ .x = dv }, .pdl = ks.pdl }, stream, &o);
+}
