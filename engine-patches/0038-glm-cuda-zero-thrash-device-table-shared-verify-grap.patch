+/// Device-table variant of writeSegs for zero-thrash shared verify CUDA graphs.
+pub fn writeSegsPtr(k: Kernels, stream: cuda.Stream, l: Layer, segs_dev: u64, rows: usize, blocks: usize, lat_ps: u64, pk_ps: u64) !void {
+    const set = k.set;
+    const ix = l.index;
+    var stamp = prof.span(k.prof, stream, .cache_write);
+    var a: cuda.Args = .{};
+    a.add(@as(i64, @intCast(l.lw)));
+    a.add(@as(i64, @intCast(lat_ps)));
+    a.add(segs_dev);
+    try cuda_pdl.launch(set.glue.lat_write_fp8_paged_segs_ptr, .{ .grid = .{ .x = @intCast(rows) }, .block = .{ .x = 512 } }, stream, &a);
+    stamp.end();
+    stamp = prof.span(k.prof, stream, .index_update);
+    defer stamp.end();
+    var b: cuda.Args = .{};
+    b.add(@as(i64, @intCast(ix.d + ix.heads)));
+    b.add(ix.ln_w);
+    b.add(ix.ln_b);
+    b.add(@as(f32, 1e-6));
+    b.add(segs_dev);
+    try cuda_pdl.launch(set.glue.index_write_segs_ptr, .{ .grid = .{ .x = @intCast(rows) }, .block = .{ .x = 32 } }, stream, &b);
+    var p: cuda.Args = .{};
+    p.add(ix.ape);
+    p.add(@as(i64, @intCast(pk_ps)));
+    p.add(segs_dev);
+    try cuda_pdl.launch(set.glue.pool_keys_segs_ptr, .{ .grid = .{ .x = @intCast(blocks) }, .block = .{ .x = 32 } }, stream, &p);
+}
