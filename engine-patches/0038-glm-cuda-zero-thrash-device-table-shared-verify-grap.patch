+++ b/zig/src/families/glm/cuda_shared_table.zig
@@ -0,0 +1,387 @@
+//! Device-resident per-layer segment descriptor table for zero-thrash shared multi-stream verify CUDA graphs.
+//!
+//! Uploaded once per round in Forward.runReady (one ~116 KiB H2D async copy before graph replay), removing all
+//! per-stream KDA ping-pong parities (`st.cur`), state/cache pointers, and per-segment `(row0, rows)` permutations
+//! from CUDA graph kernel parameters so shared C4/C8 verify windows achieve >95% graph replay hit rate.
+const std = @import("std");
+const cuda = @import("cuda");
+const kda = cuda.kda;
+const fw = @import("cuda_forward.zig");
+const glue = @import("cuda_glue.zig");
+const latent = @import("cuda_latent.zig");
+const dsa_block = @import("cuda_dsa_block.zig");
+const sparse = @import("cuda_sparse.zig");
+const kv_attn = @import("cuda_kv_shard_attn.zig");
+const weights = @import("cuda_weights.zig");
+
+/// Row stride reserved inside kv_room (pq/po) for packed `.give` rows (gq/go) during decode shared windows.
+/// Engine.shared_rows = 32, so pq[0..32) holds received peer queries and pq[32..64) holds packed outgoing queries.
+pub const give_pack_row_off: usize = 32;
+
+fn align64(n: usize) usize {
+    return (n + 63) & ~@as(usize, 63);
+}
+
+/// Bucket max segment rows to {4, 8, 16, m} so small row-count fluctuations share the same CUDA graph grids.
+pub fn bucketRows(m: usize) usize {
+    if (m <= 4) return 4;
+    if (m <= 8) return 8;
+    if (m <= 16) return 16;
+    return m;
+}
+
+pub const Table = struct {
+    d: *const cuda.Driver,
+    dev: cuda.DeviceBuffer,
+    host: cuda.HostBuffer,
+    total_bytes: usize,
+    kda_layers: usize,
+    mla_layers: usize,
+    off_copies: usize,
+    off_kda: usize,
+    off_writes: usize,
+    off_attns: usize,
+    off_pack_qa: usize,
+    off_unpack_ol: usize,
+
+    // Per-round metadata populated by fill() before graph capture/replay:
+    valid: bool = false,
+    segs: u8 = 0,
+    max_seg_bucket: u8 = 0,
+    give_rows: u8 = 0,
+    take_rows: u8 = 0,
+    attn_rows: u8 = 0,
+    max_nch: u8 = 0,
+    pool_blocks: u16 = 0,
+    kind: dsa_block.SegsKind = .dense,
+    lat_ps0: u64 = 0,
+    pk_ps0: u64 = 0,
+    rb: usize = 0,
+
+    pub fn init(d: *const cuda.Driver, w: *const weights.Weights) !Table {
+        var kl: usize = 0;
+        var ml: usize = 0;
+        for (w.layers) |l| switch (l.mixer) {
+            .kda => kl += 1,
+            .mla => ml += 1,
+        };
+        var off: usize = 0;
+        const off_copies = off;
+        off = align64(off + kl * @sizeOf(glue.Copies));
+        const off_kda = off;
+        off = align64(off + kl * @sizeOf(kda.Segs));
+        const off_writes = off;
+        off = align64(off + ml * @sizeOf(dsa_block.WriteSegs));
+        const off_attns = off;
+        off = align64(off + ml * @sizeOf(latent.AttnSegs));
+        const off_pack_qa = off;
+        off = align64(off + @sizeOf(glue.Copies));
+        const off_unpack_ol = off;
+        off = align64(off + @sizeOf(glue.Copies));
+        const total = @max(off, 64);
+
+        var dev = try cuda.DeviceBuffer.alloc(d, total);
+        errdefer dev.free();
+        const host = try cuda.HostBuffer.alloc(d, total);
+        return .{
+            .d = d,
+            .dev = dev,
+            .host = host,
+            .total_bytes = total,
+            .kda_layers = kl,
+            .mla_layers = ml,
+            .off_copies = off_copies,
+            .off_kda = off_kda,
+            .off_writes = off_writes,
+            .off_attns = off_attns,
+            .off_pack_qa = off_pack_qa,
+            .off_unpack_ol = off_unpack_ol,
+        };
+    }
+
+    pub fn deinit(t: *Table) void {
+        t.dev.free();
+        t.host.free();
+    }
+
+    pub fn copiesDev(t: *const Table, li: usize) u64 {
+        return t.dev.ptr + t.off_copies + li * @sizeOf(glue.Copies);
+    }
+
+    pub fn kdaDev(t: *const Table, li: usize) u64 {
+        return t.dev.ptr + t.off_kda + li * @sizeOf(kda.Segs);
+    }
+
+    pub fn writesDev(t: *const Table, di: usize) u64 {
+        return t.dev.ptr + t.off_writes + di * @sizeOf(dsa_block.WriteSegs);
+    }
+
+    pub fn attnsDev(t: *const Table, di: usize) u64 {
+        return t.dev.ptr + t.off_attns + di * @sizeOf(latent.AttnSegs);
+    }
+
+    pub fn packQaDev(t: *const Table) u64 {
+        return t.dev.ptr + t.off_pack_qa;
+    }
+
+    pub fn unpackOlDev(t: *const Table) u64 {
+        return t.dev.ptr + t.off_unpack_ol;
+    }
+
+    pub fn giveQaBuf(kv: *const kv_attn.Ctx, rb: usize) u64 {
+        return kv.pq + give_pack_row_off * rb;
+    }
+
+    pub fn giveOlBuf(kv: *const kv_attn.Ctx, rb: usize) u64 {
+        return kv.po + give_pack_row_off * rb;
+    }
+
+    fn hostSlice(t: *Table, comptime T: type, off: usize, count: usize) []T {
+        const ptr: [*]T = @ptrCast(@alignCast(t.host.bytes.ptr + off));
+        return ptr[0..count];
+    }
+
+    /// Populate all 45 layers' segment tables in pinned host memory and upload them asynchronously in one H2D copy.
+    /// Sets `t.valid = false` if the current shared window is not eligible (e.g. mixed dense+sparse, host KV, or small kv_room).
+    pub fn fill(t: *Table, f: *const fw.Forward, r: fw.Rank) !void {
+        t.valid = false;
+        const b = r.b;
+        const n = r.segs.len;
+        if (b.prefill or !f.kda_wide or !f.m.shared_segs or !f.m.shared_writes) return;
+        if (n == 0 or n > latent.max_segs or n > kda.max_segs or n > glue.max_copies) return;
+        if (b.part_chunks == 0 or b.part_chunks < @max(b.nch, latent.chunksFor(sparse.width))) return;
+
+        var max_seg_rows: usize = 0;
+        for (r.segs) |g| {
+            if (g.rows == 0 or g.rows > b.part_rows) return;
+            max_seg_rows = @max(max_seg_rows, g.rows);
+        }
+        const bucket = bucketRows(max_seg_rows);
+        if (bucket > 255) return;
+
+        // Validate sharded room capacity if KV_SHARD is active.
+        var give_rows: usize = 0;
+        var take_rows: usize = 0;
+        var attn_rows: usize = 0;
+        var entries: usize = 0;
+        var roles: [latent.max_segs]kv_attn.Role = undefined;
+        for (r.segs, 0..) |g, i| {
+            const rl: kv_attn.Role = if (f.kv) |kv| kv_attn.role(g.st.hold, kv.rank) else .local;
