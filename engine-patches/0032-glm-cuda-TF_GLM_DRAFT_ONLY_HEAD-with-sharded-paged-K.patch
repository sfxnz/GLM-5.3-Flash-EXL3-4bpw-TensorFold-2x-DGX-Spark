+    /// A layer's down: bf16 tiled as linearB, or (TF_GLM_DRAFT_DOWN8) packed at 8 bits as cuda_tile packs dense linears.
+    fn linearDown(l: *Loader, names: []const []const u8, rows: []const usize, kk: usize, part: ?[4]usize) !mm.Tiled {
+        if (!l.down8) return l.linearB(names, rows, kk, part);
+        const n = try l.stack(names, rows, kk, part);
+        const k = if (part) |p| p[3] else kk;
+        const host = try l.gpa.alloc(u16, n * k);
+        defer l.gpa.free(host);
+        try l.tmp.download(0, std.mem.sliceAsBytes(host));
+        const words = try l.gpa.alloc(u32, n * k * 8 / 32);
+        defer l.gpa.free(words);
+        const scales = try l.gpa.alloc(u16, n * (k / 64));
+        defer l.gpa.free(scales);
+        qpack.quantize(8, host, n, k, words, scales);
+        const sizes = mm.packedBytes(n, k, 8);
