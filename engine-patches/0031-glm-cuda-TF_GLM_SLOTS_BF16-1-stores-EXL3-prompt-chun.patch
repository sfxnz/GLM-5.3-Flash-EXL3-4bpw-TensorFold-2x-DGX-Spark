diff --git a/zig/kernels/cuda/exl3_experts.cu b/zig/kernels/cuda/exl3_experts.cu
index a840aea25..4e9b9f3e7 100644
--- a/zig/kernels/cuda/exl3_experts.cu
+++ b/zig/kernels/cuda/exl3_experts.cu
@@ -333,10 +333,11 @@ extern "C" __global__ void __launch_bounds__(256, 2) tf_exl3_prompt_gu_k6(const
     if (threadIdx.x < TPM) rows_sh[threadIdx.x] = (int)threadIdx.x < cnt ? members[first + threadIdx.x] : -1;            \
     __syncthreads();                                                                                                     \
     const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
-// Block (256 model-width columns, item): y[row][slot][:] = the down epilogue of the item's pairs (this rank's share).
+// Block (256 model-width columns, item): y[row][slot][:] = the down epilogue of the item's pairs (this rank's share);
+// fp32, or with bf16 (TF_GLM_SLOTS_BF16) the same fp32 values rounded once to bf16.
 template <int K2, int NBA>
 __device__ __forceinline__ void prompt_down_n(const half* __restrict__ Xd, const uint64_t* __restrict__ Td, const half* __restrict__ svh_d,
-        float* __restrict__ y, int K, int D, unsigned char* smem_raw, const int* rows_sh, int cb, int e, int cnt, int warp, int lane) {
+        void* __restrict__ y, int K, int D, int bf16, unsigned char* smem_raw, const int* rows_sh, int cb, int e, int cnt, int warp, int lane) {
     float acc[TMT][NBA][4];
     tmain<1, TPM, K2, NBA, 4>(Xd, Xd, Td, Td, rows_sh, e, K, D >> 4, cb, 1, smem_raw, acc);
     float* Ed = reinterpret_cast<float*>(smem_raw);
@@ -356,8 +357,17 @@ __device__ __forceinline__ void prompt_down_n(const half* __restrict__ Xd, const
                 float o[4];
 #pragma unroll
                 for (int j = 0; j < 4; ++j) o[j] = v[j] * HAD_SCALE * __half2float(svh_d[(size_t)e * D + n + j]);
-                // one 16-byte store (y rows and n are 16-byte aligned: Kernels.run checks y)
-                *reinterpret_cast<float4*>(y + (size_t)p * D + n) = make_float4(o[0], o[1], o[2], o[3]);
+                if (bf16) {
+                    const __nv_bfloat162 o01 = __floats2bfloat162_rn(o[0], o[1]);
+                    const __nv_bfloat162 o23 = __floats2bfloat162_rn(o[2], o[3]);
+                    uint2 packed;
+                    packed.x = *reinterpret_cast<const uint32_t*>(&o01);
+                    packed.y = *reinterpret_cast<const uint32_t*>(&o23);
+                    *reinterpret_cast<uint2*>(reinterpret_cast<__nv_bfloat16*>(y) + (size_t)p * D + n) = packed;
+                } else {
+                    // one 16-byte store (y rows and n are 16-byte aligned: Kernels.run checks y)
+                    *reinterpret_cast<float4*>(reinterpret_cast<float*>(y) + (size_t)p * D + n) = make_float4(o[0], o[1], o[2], o[3]);
+                }
             }
         }
     }
@@ -365,30 +375,30 @@ __device__ __forceinline__ void prompt_down_n(const half* __restrict__ Xd, const
 // The item's main loop and epilogue compiled for its 8-member column blocks (exl3_prompt.cuh TF_EXL3_PROMPT_NBA).
 template <int K2>
 __device__ __forceinline__ void prompt_down(const half* __restrict__ Xd, const uint64_t* __restrict__ Td, const half* __restrict__ svh_d,
-        float* __restrict__ y, int K, int D, unsigned char* smem_raw, const int* rows_sh, int cb, int e, int cnt, int warp, int lane) {
