+/// Whether `run` takes the prompt experts (and so can write bf16 slot rows, TF_GLM_SLOTS_BF16).
+pub fn promptPath(w: Experts, count: usize, dims: usize, width: usize, limit: f32, prompt: bool) bool {
+    return prompt and dims % 256 == 0 and width % 128 == 0 and common.prompt.eligible(layer(w, count, dims, width, limit));
+}
+
 pub fn run(k: *const Kernels, ek: *const experts.Kernels, stream: cuda.Stream, w: Experts, sc: Scratch, plan_buf: cuda.grouped.Plan, x: u64, x_stride: usize, picks: u64, slots: usize, rows: usize, count: usize, dims: usize, width: usize, limit: f32, prompt: bool, ey: u64, xd: u64) !void {
+    return runFormat(k, ek, stream, w, sc, plan_buf, x, x_stride, picks, slots, rows, count, dims, width, limit, prompt, ey, xd, false);
+}
+
+/// `bf16_slots`: the slot rows `ey` are bf16 (prompt experts only: promptPath), else fp32.
+pub fn runFormat(k: *const Kernels, ek: *const experts.Kernels, stream: cuda.Stream, w: Experts, sc: Scratch, plan_buf: cuda.grouped.Plan, x: u64, x_stride: usize, picks: u64, slots: usize, rows: usize, count: usize, dims: usize, width: usize, limit: f32, prompt: bool, ey: u64, xd: u64, bf16_slots: bool) !void {
     _ = xd;
     if (slots != top_k + 1) return error.UnsupportedTopK;
     if (dims % 256 != 0 or width % 128 != 0) return error.UnreadableExl3;
     const l = layer(w, count, dims, width, limit);
+    if (bf16_slots and !promptPath(w, count, dims, width, limit, prompt)) return error.Exl3Shape;
+    const eb: usize = if (bf16_slots) 2 else 4;
     if (prompt and common.prompt.eligible(l)) {
         const scratch = try common.prompt.scratch(sc.picks, l, @min(rows, prompt_rows), slots);
         var at: usize = 0;
         while (at < rows) : (at += prompt_rows) {
             const n: usize = @min(prompt_rows, rows - at);
-            try k.prompt.run(k, ek.router, stream, l, x + at * x_stride * 2, x_stride, picks + at * slots * 4, n, scratch, plan_buf, ey + at * slots * dims * 4, count);
+            try k.prompt.runFormat(k, ek.router, stream, l, x + at * x_stride * 2, x_stride, picks + at * slots * 4, n, scratch, plan_buf, ey + at * slots * dims * eb, count, bf16_slots);
         }
         return;
     }
